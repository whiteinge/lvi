#!/bin/sh
# lvi-gitchanges [-w auto|WID] [--focus] [--jump] [--print] [--repo] [--staged|--unstaged] [REF | REF..REF] [-- PATHSPEC...]
#
# Turn git changes into a `lvi-list` quickfix and jump to the first hunk; `n`/`N`
# then step them like any other list. A git producer in the same mold as
# lvi-search -- it turns `git diff` into `file:line1-line2:text` entries, one per hunk,
# carrying that hunk's own diff as the entry BODY, and lets lvi-list's shared
# step/paint/status machinery do the rest.
#
#   lvi-gitchanges              uncommitted changes (working tree vs HEAD)
#   lvi-gitchanges --unstaged   changes NOT yet staged (working tree vs index)
#   lvi-gitchanges --staged     STAGED changes (index vs HEAD)
#   lvi-gitchanges HEAD~3..     changes across a commit range
#   lvi-gitchanges abc123       changes introduced by a single commit (git show)
#   lvi-gitchanges --staged REF staged changes measured against REF (index vs REF)
#
# The middle three answer the three questions you actually have while building a
# commit, and they are git's own three diffs:
#
#   --unstaged  what is left to stage  working tree vs index  git diff
#   --staged    what you will commit   index vs HEAD          git diff --cached
#   REF         what was committed     a commit or range      git show
#
# --staged is also the set you pick from to take something back OFF the index.
#
# The default is deliberately none of them: working tree vs HEAD, everything
# uncommitted, staged or not -- the "what have I done since HEAD" view, which is
# what you want when you are not mid-stage. --unstaged is the complement of
# --staged, so it takes no REF (it compares against the index, and there is
# nothing else to measure from).
#
# --staged is `git diff --cached`: it steps what you have staged, not what you
# have edited -- so after moving hunks onto the index in lvi-stagediff (each :w on
# the index pane stages), `lvi-gitchanges --staged` walks exactly those regions,
# folds and all. Each mode loads into its OWN list (`gitchanges`, `gitunstaged`,
# `gitstaged`), so all three can coexist and be themed and stepped independently.
# They are snapshots, not live views: rerun after staging more.
#
# SCOPE -- the current file inside lvi, the whole repo outside. Run from a map or
# a hook and $LVI_FILE is in the environment, so the diff is scoped to the file
# you are looking at (git gets it as a pathspec); that is the common case, and
# the one where a repo-wide list would bury the hunks you came for. Run it from a
# shell and there is no current file, so you get the repo. The narrowing is what
# you opt OUT of, with `--repo`; an explicit `-- PATHSPEC...` overrides it too. A
# pathless buffer simply widens to the repo rather than failing.
#
# WHERE THE ENTRIES GO: into a live view when there is one to push to -- $LVI_WID
# is set (lvi spawned us) or -w named a view -- and to STDOUT otherwise. So a bare
# shell invocation PRINTS; it never reaches for `-w auto` and mutates whichever
# session happens to be running. That is what makes the outside-in path plain
# composition instead of a launcher:
#
#     lvi-gitchanges HEAD~3.. > qf && lvi -q qf
#
# `lvi -q` is vim's -q: it parks the file in $LVI_QUICKFIX and fires the `ready`
# event, and the hook in contrib/lvirc.sample.vim loads it as a list. Without that
# rc line, -q does nothing. `--print` forces stdout even from inside lvi. Print
# mode exits 1 when there is nothing to report, so `&&` will not open an editor on
# an empty list.
#
# DELETED FILES ARE SKIPPED. A deletion's hunks have nowhere to land: git reports
# `+++ /dev/null` and a `+0,0` range, so an entry for one would send you to line 1
# of a file that is not there -- the "why am I here?" jump. Renames and copies are
# KEPT, unlike the `--diff-filter=AM` this convention started from: their line
# numbers refer to the new path, which exists, and a rename with content changes
# is exactly a change you want to step. A rename with no content changes produces
# no hunks and so needs no filtering. When a deletion IS dropped, the run says so
# rather than leaving you to notice the gap.
#
# BODIES: each entry carries its hunk's diff as indented body lines -- vim's
# multi-line quickfix shape, which lvi-list stores and `lvi-list preview` prints
# (bind that to a tmux popup; see the lvi-list header). Stepping still echoes only
# the one-line header text. The diff is -U0, so a body is the changed lines and
# nothing around them; the context you would want is the buffer you jumped into.
# The indent is load-bearing: a diff line like `-foo:12: bar` has the shape of an
# entry header, and lvi-list ends an entry at the next line that does. It reads a
# LEADING BLANK as "not a header" -- the two halves of one contract, so a producer
# that indents and a consumer that checks are both required.
#
# PATHS: entries name files ABSOLUTELY. git reports paths relative to the repo
# top, which is not necessarily where lvi was launched from, and lvi-list matches
# an entry to the buffer by canonical path -- absolute is the one spelling that is
# right from any directory. (This wants the lvi-list that canonicalises; an older
# one compared raw strings and would miss.)
#
# DISK, NOT BUFFER: git diffs the file ON DISK (or the index, with --staged), so
# this reflects your last :w / `git add`, not unsaved edits. Save or stage first
# if a hunk looks stale. --staged line numbers are index-side, so they best match
# the buffer when the staged and working versions agree (as they do right after
# you stage a hunk in lvi-stagediff); single-commit mode emits REF's own line
# numbers, which drift from today's buffer by however much the file has changed
# since. (Contrast lvi-search, which greps the live buffer via %p.)
#
# Bind it with :bg -- git is non-interactive so it needs no tty, and :bg avoids
# the alt-screen flash that :silent ! causes:
#     on write lvi-gitchanges                    " keep the margin current
#     map \gg :bg lvi-gitchanges --focus --jump<CR>      " walk this file's hunks
#     map \gu :bg lvi-gitchanges --focus --jump --unstaged<CR>  " ...only unstaged
#     map \gs :bg lvi-gitchanges --focus --jump --staged<CR>    " ...only staged
#     map \gr :bg lvi-gitchanges --focus --jump --repo<CR>      " ...the whole repo
#     map ]c :bg lvi-list next gitchanges<CR>    " or step it without stealing focus
#     map [c :bg lvi-list prev gitchanges<CR>
# Theme the marks in your rc (un-themed = invisible; see lvi-list); give the three
# lists distinct colors so the modes read apart at a glance:
#     hi gitchanges  bg=22 pri=10
#     hi gitunstaged bg=94 pri=10
#     hi gitstaged   bg=28 pri=10
#
# --focus AND --jump ARE SEPARATE, AND BOTH OPT-IN. `--focus` only aims n/N at
# this list; `--jump` only moves the cursor onto an entry. Neither implies the
# other, here or in any other contrib producer -- a flag named for one thing
# doing two is how a vocabulary rots. So all four combinations mean something:
#
#   (bare)          put, paint, count. Touches nothing you were doing.
#   --focus         aim n/N at the hunks, leave the cursor alone.
#   --jump          go to a hunk without stealing what n/N point at.
#   --focus --jump  the walk: what you want on a key.
#
# Both are opt-in because this runs from two places with opposite needs. From a
# key, aiming and landing IS the gesture. From `on write` it must do neither:
# yanking the focused list away from your search and teleporting the cursor on
# every save is not a margin, it is an ambush. The invocation that fires
# unattended is the SAFE one, so a rc that forgets a flag costs you a jump
# instead of your place in a file.
#
# `on write` and not `on change`: the diff is read from the file on DISK, so the
# write is the one moment its snapshot is guaranteed to match the buffer. On
# change it would show you the last-saved state while you type.
#
# Config: LVI (client, default `lvi`). Needs git on PATH, and lvi-list when
# pushing to a view.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac
LVI=${LVI:-lvi}

die() { echo "lvi-gitchanges: $*" >&2; exit 1; }
command -v git >/dev/null 2>&1 || die "git not found on PATH"

want_wid=; doprint=; repo=; staged=; unstaged=; focus=; jump=
while :; do
  case ${1:-} in
    -w)                   want_wid=${2:-}; [ -n "$want_wid" ] || die "-w needs auto|WID"; shift 2 ;;
    --print)              doprint=1; shift ;;
    --focus)              focus=1; shift ;;
    --jump)               jump=1; shift ;;
    --repo|--all)         repo=1; shift ;;
    --staged|--cached)    staged=1; shift ;;
    --unstaged|--modified) unstaged=1; shift ;;
    *)                    break ;;
  esac
done
ref=; case ${1:-} in ''|--) ;; *) ref=$1; shift ;; esac
[ "${1:-}" = "--" ] && shift                  # whatever is left is a pathspec list

[ -n "$staged" ] && [ -n "$unstaged" ] && die "--staged and --unstaged are opposites; pick one"
# A REF would have to be the thing compared against, and --unstaged has already
# spent that slot on the index. Refuse rather than quietly ignore one of them.
[ -n "$unstaged" ] && [ -n "$ref" ] && die "--unstaged compares the working tree to the index; it takes no REF"

# Scope. An explicit pathspec wins; then --repo; then the current file, which is
# the narrowing that only exists because lvi told us what it is looking at.
if [ $# -eq 0 ] && [ -z "$repo" ] && [ -n "${LVI_FILE:-}" ]; then set -- "$LVI_FILE"; fi

# Push into a view, or print? Having a view to talk to is the whole test -- no
# tty guessing, because the primary binding (:bg) hands us a stdout that is not
# a tty and would read as "print" under git-quickfix's `[ -t 1 ]` rule.
target=${want_wid:-${LVI_WID:-}}
push=; [ -n "$target" ] && [ -z "$doprint" ] && push=1
[ -n "$push" ] && { command -v lvi-list >/dev/null 2>&1 || die "lvi-list not found on PATH"; }

name=gitchanges
[ -n "$staged" ] && name=gitstaged
[ -n "$unstaged" ] && name=gitunstaged
wflag=; [ -n "$want_wid" ] && wflag="-w $want_wid"
send() { "$LVI" -w "$target" --detach -- "$@"; }

# Absolute entry paths need the repo root; resolving it also doubles as the
# "are we even in a repo?" check, before any ref can muddy the error.
LVI_GC_TOP=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
[ -n "$LVI_GC_TOP" ] || die "not inside a git repository"
LVI_GC_TOP="$LVI_GC_TOP/"; export LVI_GC_TOP

# Choose the diff. --unstaged -> bare `git diff`, which IS working tree vs index.
# --staged -> index vs REF (HEAD by default), git's `--cached`. Otherwise: no ref
# -> working tree vs HEAD; a range -> that range; a lone commit -> just that
# commit (git show), mirroring the git-quickfix convention.
gitdiff() {
  if [ -n "$unstaged" ];  then git diff -U0 -- "$@"
  elif [ -n "$staged" ]; then
    if [ -n "$ref" ]; then git diff --cached -U0 "$ref" -- "$@"
    else                   git diff --cached -U0 -- "$@"; fi
  elif [ -z "$ref" ];                then git diff -U0 HEAD -- "$@"
  elif [ "${ref#*..}" != "$ref" ];   then git diff -U0 "$ref" -- "$@"
  else                                    git show -U0 --first-parent -m "$ref" -- "$@"
  fi
}
what=uncommitted
[ -n "$staged" ] && what=staged
[ -n "$unstaged" ] && what=unstaged
[ -n "$ref" ] && what="'$ref'"
diff=$(gitdiff "$@" 2>/dev/null) || die "git failed (not a repo, or bad ref '$ref'?)"

# One entry per hunk -- `<abs path>:<new-start>-<new-end>:+A -D  <section context>`
# (a one-line hunk drops the range half) -- with
# the hunk's own lines indented under it as the body. @@ -a,d +s,i @@ ctx; a
# comma-less count means 1, and +s,0 is a pure deletion (clamped to line 1).
# Tracking `+++` is what skips deleted files and names the rest: git's own header
# is the only place the destination path appears, and /dev/null is how it says
# there isn't one. Read the root from ENVIRON, not -v: awk expands backslash
# escapes in a -v value, and a repo path may contain one.
entries=$(printf '%s\n' "$diff" | awk '
  /^diff /   { inh=0; next }
  /^--- /    { inh=0; next }
  /^\+\+\+ / {
    inh=0; p=substr($0, 5)
    if (p == "/dev/null") { skip=1; next }        # a deletion: nowhere to jump
    skip=0; sub(/^b\//, "", p)
    f = (substr(p, 1, 1) == "/") ? p : ENVIRON["LVI_GC_TOP"] p
    next }
  /^@@ / {
    inh=0
    if (skip) next
    add=$3; sub(/^\+/,"",add); s=add
    if (add ~ /,/) { sub(/.*,/,"",add); sub(/,.*/,"",s) } else add=1
    if (s+0 < 1) s=1
    del=$2; sub(/^-/,"",del); if (del ~ /,/) sub(/.*,/,"",del); else del=1
    ctx=$0; sub(/^@@[^@]*@@ ?/,"",ctx)
    label=sprintf("+%d -%d", add, del)
    if (ctx != "") label=label "  " ctx
    # A hunk is a RANGE, in the GNU spelling `file:L1-L2:`, so lvi-list can mark
    # the whole hunk in a gutter column instead of just its first line. Every
    # other consumer already lands a range on its start, so this is invisible to
    # them. A pure deletion (+0) has no new-side span, so it stays a point.
    e = (add + 0 > 0) ? s + add - 1 : s
    if (e + 0 > s + 0) printf "%s:%s-%s:%s\n", f, s, e, label
    else printf "%s:%s:%s\n", f, s, label
    inh=1; next }
  inh { print " " $0 }                            # indent: see BODIES -- a body
')                                                # line must not look like a header

# Deletions were skipped silently above; count them so the run can say so.
deleted=$(printf '%s\n' "$diff" | grep -c '^+++ /dev/null')
hunks=$(printf '%s\n' "$entries" | grep -c '^[^:[:space:]][^:]*:[0-9]')
# The note rides along with the EMPTY answer too: "no changes" when a staged
# deletion is the only change would be the very gap this is here to close.
skipped=; [ "$deleted" -gt 0 ] && skipped=" ($deleted deleted file(s) skipped)"

if [ -z "$push" ]; then
  [ -n "$entries" ] || { echo "lvi-gitchanges: no $what changes$skipped" >&2; exit 1; }
  printf '%s\n' "$entries"
  [ -n "$skipped" ] && echo "lvi-gitchanges:$skipped" >&2
  exit 0
fi

if [ -z "$entries" ]; then
  # Clear the paint and the stale counter; the notice itself is a one-shot
  # answer, so an ephemeral :msg, not a status segment that would sit forever.
  send "hl $name" "hl $name-cur" "status $name" "msg $name: no changes$skipped"
  exit 0
fi

# --at-cursor: a refresh mid-walk keeps your place instead of resetting the index
# to the top -- which is what makes `on write` usable, and is the same reason
# lvi-lint seeds this way. --focus and --jump are separate and both opt-in, so a
# hook moves neither the cursor nor what n/N point at (see the header).
printf '%s\n' "$entries" | lvi-list $wflag put "$name" --at-cursor ${focus:+--focus}

# MARGIN GLYPHS, per LINE rather than per hunk -- which is the whole reason the
# marks channel is keyed by line: one hunk carries `+` on the lines that were
# added and `~` on the ones that replaced something. Runs, not whole hunks: a
# hunk that adds a paragraph and edits a word elsewhere reports both truthfully.
# A run of removals with nothing added is a `-` on the line ABOVE the gap, which
# is where git's own `@@ -13,2 +14,0 @@` points and where gitgutter draws it: one
# cell cannot show a gap between two lines, so it marks an edge of it.
# The group names are lvi-diff's (GitAdd/GitDel/GitChange), so the two git tools
# share one vocabulary and one `hi` line themes both.
#
# gitdiff runs -U0, so a hunk body is only -/+ lines and each hunk is one run.
# The context-line branch below is what makes the pass right for a diff that has
# context anyway, rather than a rule that quietly depends on the flag.
printf '%s\n' "$diff" | awk '
  function flush() {
    if (na > 0) {
      g   = (ndel > 0) ? "~" : "+"
      grp = (ndel > 0) ? "GitChange" : "GitAdd"
      for (i = 1; i <= na; i++) printf "%s:%s\t%s\t%s\n", f, add[i], g, grp
    } else if (ndel > 0 && nl >= 1) {
      # The line ABOVE the gap: nl is the next new-side line, which is below it
      # once any new-side line has been emitted in this hunk. At the hunk start
      # nl is still the +s,0 line git itself named, and a deletion from line 1
      # has no line above to mark: both fall out of the same comparison.
      # (No apostrophes or backticks in here -- the awk program is one
      # single-quoted shell word, and either one ends it.)
      printf "%s:%s\t-\tGitDel\n", f, (nl > hs) ? nl - 1 : nl
    }
    na = 0; ndel = 0
  }
  /^diff / { if (inh) flush(); inh = 0; next }
  /^--- /  { if (inh) flush(); inh = 0; next }
  /^\+\+\+ / {
    if (inh) flush()
    inh = 0; p = substr($0, 5)
    if (p == "/dev/null") { skip = 1; next }
    skip = 0; sub(/^b\//, "", p)
    f = (substr(p, 1, 1) == "/") ? p : ENVIRON["LVI_GC_TOP"] p
    next }
  /^@@ / {
    if (inh) flush()
    inh = 0
    if (skip) next
    s = $3; sub(/^\+/, "", s); sub(/,.*/, "", s)
    if (s + 0 < 1) s = 1
    nl = s + 0; hs = nl; inh = 1; next }
  inh && /^\\/ { next }                          # "\ No newline at end of file"
  inh && /^-/   { ndel++; next }
  inh && /^\+/  { add[++na] = nl; nl++; next }
  inh          { flush(); nl++ }                 # context line: the run ends
  END { if (inh) flush() }
' | lvi-list $wflag marks "$name"

# `next "$name"`, not a bare `next`: --jump must work without --focus, and a
# bare step acts on the FOCUSED list -- which may be someone else's, or none.
[ -n "$jump" ] && lvi-list $wflag next "$name"
# After `next`, so it lands on top of the entry text lvi-list just echoed: when
# there is a deletion to report it outranks a line you are already looking at,
# and when there is none (the usual case) the echo stands untouched.
[ -n "$skipped" ] && send "msg $name: $hunks hunks$skipped"
exit 0
