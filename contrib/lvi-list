#!/bin/sh
# lvi-list -- external quickfix/location lists for lvi.
#
# A "list" is a plain file of `file:line[:col]:text` entries (grep -Hn / compiler
# / linter output -- the GNU error-message format, which vim calls quickfix; see
# THE FORMAT below), each optionally followed by indented body lines (a compiler
# note, a multi-line diagnostic) that `preview` shows on demand -- n/N step the
# headers and skip the bodies. lvi knows nothing of lists:
# this script owns them, and drives lvi purely through the socket -- jumping the
# cursor, painting the :hl overlay, and setting a :status segment. Multiple named
# lists coexist; one is "focused" and the bare step commands act on it.
#
#   producer | lvi-list put NAME [--focus] [--at-cursor[-back]] [--cols=UNIT]
#                                 [--paint=POLICY]
#                                              entries on stdin -> a list
#                                              (--cols: what this producer's columns
#                                              count -- byte (default), char, display)
#                                              (--at-cursor: seed the step index from
#                                              the cursor, so the step that follows is
#                                              relative to it -- a producer REFRESHING a
#                                              list mid-walk continues forward instead of
#                                              restarting at 1, and a search starts where
#                                              you are. -back seeds for a backward step)
#   lvi-list next|prev|nfile|pfile [NAME]     step (NAME defaults to the focused list)
#   lvi-list first|last [NAME]                 go to the first / last entry (vim :cfirst/:clast);
#                                              no list wraps, so these are the manual wrap
#   lvi-list current [NAME]                    re-jump to the CURRENT entry, no step (vim :cc);
#                                              recall after opening a fold n/N landed you on
#   lvi-list here [NAME]                       jump to the first entry at/after the cursor
#   lvi-list preview [NAME]                    print the current entry + its body to stdout
#                                              (NAME defaults to the last-stepped list;
#                                              bind it to a tmux popup -- see PREVIEW below)
#   lvi-list goto|switch                       fzf over entries / over list names
#   lvi-list focus [NAME] | ls | paint [NAME]
#   lvi-list hide [NAME]                       stop showing a list (keep it; n/N re-show)
#   lvi-list save NAME PATH | load PATH [NAME] [--focus] [--cols=UNIT]
#   lvi-list drop NAME | clear NAME | path NAME
#
# WHERE LISTS LIVE: beside the view's socket, derived from $LVI_SOCK
# (`.../lvi-$uid/$wid`) so the path can never drift from the one the editor chose:
#   $LVI_SOCK.lists/<name>        the entries (raw; multi-line bodies kept)  (per view)
#   $LVI_SOCK.lists/<name>.cur    the current index  (1-based; 0 = before first)
#   $LVI_SOCK.lists/<name>.cols   what its columns count (absent = byte)
#   $LVI_SOCK.lists/<name>.paint  how its entries paint (absent = sign)
#   $LVI_SOCK.focus               the focused list name
# A name may not end in `-cur`: a list paints the `:hl` groups <name> and
# <name>-cur, so `x-cur` would be a second writer on `x`'s current-entry group
# and the two would take turns erasing each other (`:hl` replaces a whole group).
# $wid.lists is a directory, so socket discovery (which filters `[ -S ]`) skips it.
# Persistent lists escape this disposable tree via `save`/`load` to any path.
#
# MATCHING AN ENTRY TO THE BUFFER: "is this entry in the file I'm looking at?"
# decides whether `jump` needs an :e and which lines `paint` lights, and the two
# sides rarely agree on spelling. lvi calls the buffer whatever was on its command
# line; git names files relative to the repo top; a grep run in a subdirectory
# names them relative to that. So both sides are compared CANONICAL, not raw --
# absolutised against $PWD and with `.`/`..`/`//` collapsed. $PWD is the right
# anchor because a script lvi spawned inherits lvi's cwd, which is the same
# directory the buffer names are relative to. Single-file producers that emit
# $LVI_FILE verbatim (lvi-search, lvi-lint) matched before this and still do; it
# is cross-file lists -- a project grep, git changes across a repo -- that need it.
#
# The collapse is LEXICAL, deliberately not `realpath`: resolving symlinks would
# make a buffer opened through one stop matching an entry that names the real
# file (and the reverse), and it would cost a fork per entry inside awk's scan.
# The consequence is honest -- two genuinely different spellings of one file
# THROUGH a symlink still read as different files.
#
# THE FORMAT has a name and a specification: it is the GNU error-message format
# (GNU Coding Standards 4.3), which vim calls the quickfix format and which
# every compiler, linter and `grep -Hn` on your machine already prints. The
# shapes accepted here, all of them GNU's:
#   file:line: text                 file:line:col: text
#   file:line.col: text             file:line1.col1-line2.col2: text
#   file:line1.col1-col2: text      file:line1-line2: text
# A range lands on its START; the end says how far the complaint reaches, which
# is a paint concern and not a second place to put the cursor. GNU's
# `program:file:line:` form is deliberately NOT accepted: a leading bare word is
# indistinguishable from a filename, and taking it would cost the one thing
# holding prose out of a list. Producers that emit it (lvi-lint's backends) drop
# the program name themselves.
#
# THE COLUMN FIELD is optional per ENTRY, not per list: `file:line:text` and
# `file:line:col:text` mix freely in one file, which is what lets grep -Hn and a
# compiler feed the same list. Of the tools here, lvi-spell and most lvi-lint
# backends name a column; lvi-search and lvi-gitchanges cannot (grep reports
# lines, and a diff hunk has no column). Who reads one:
#   jump              lands on it exactly, via `:pos L C UNIT`.
#   put --at-cursor   weighs it when seeding, so a search can resume from
#                     between two entries on ONE line; a col-less entry is
#                     weighed by its line alone (see the seed below).
#   paint             marks the entry's first cell (`L:1-1`) unless the list
#                     asked for otherwise -- see PAINT POLICY below, which is
#                     what decides whether a column lights the match instead.
#   here              compares LINES only, on purpose. It answers "which entry
#                     is nearest me", where the diagnostic on the line you are
#                     standing on is the one you want -- unlike --at-cursor,
#                     which answers "what have I already passed" and so must
#                     exclude your own position.
#
# WHAT A COLUMN COUNTS is the producer's business, and the number cannot say.
# GNU prescribes DISPLAY columns -- tab stops every 8, Unicode widths -- and gcc
# emits them; most linters count characters; lvi counts bytes. All three agree
# on ASCII text without tabs, so a mismatch stays invisible until a tab or a
# multibyte character puts the cursor near the complaint instead of on it. So
# the producer declares once, per list: `put --cols=byte|char|display` (default
# byte, what everything meant before this existed), recorded beside the entries
# and handed to `:pos`, which converts -- only the editor has the line's bytes
# to convert with. The seed still compares against a BYTE cursor column, so a
# non-byte list can seed one entry off within a single line; the walk itself is
# unaffected, being arithmetic on the index.
#
# PAINT POLICY (`put --paint=`) is what an entry LOOKS LIKE on screen. A list is
# either something you read or something you see, and only its producer knows
# which:
#   sign    (default) mark the entry's first cell, `L:1-1`. A colored leading
#           cell reads as a poor-man's sign down the edge of the screen, where
#           lighting the offending token would bury the very text you are
#           scanning -- right for a linter, whose entries you READ.
#   extent  light the entry's RANGE (`L:C1-C2`) where it has one, falling back
#           to the sign where it does not -- right for a search, where the match
#           IS the thing you are looking at.
#   cur     sign every entry but light the CURRENT one's range: vi with
#           `hlsearch` off.
# Recorded beside the entries (`<name>.paint`) rather than taken as a flag on the
# `paint` subcommand, because paint runs from a dozen places in here -- every
# step, every jump, `:on bufenter` -- and a subcommand flag would reach only the
# last of them.
#
# An extent needs BYTE columns, because `:hl` takes byte ranges and never learned
# units the way `:pos` did. lvi-list cannot convert: that needs the line's bytes,
# which only the editor has -- a col-bearing entry's TEXT is a diagnostic
# message, not the line it points at. So a char/display list degrades to signs
# rather than mispaint, and so does a multi-line range (`L1.C1-L2.C2`), since one
# `:hl` range covers one line.
#
# One ambiguity is inherent to the format rather than to any parser here: a
# col-less entry whose TEXT opens with digits and a colon (`f.c:7:42: foo`) is
# indistinguishable from a col-bearing one and reads as column 42. Vim reads it
# that way too (its errorformat tries `%f:%l:%c:%m` before `%f:%l:%m`). It can
# shift a seed by one entry; it cannot derail a walk. A producer that knows its
# columns should emit them -- then field 3 really is one.
#
# THE FILENAME may contain anything but a colon, which is the property that
# makes the parse deterministic (vim gets the same one from 'isfname', whose
# default excludes `:`). It may also contain a blank, which vim's default does
# NOT allow -- `we $ird.txt` is a real filename and an indented body line is
# already what keeps prose out of a list.
#
# SPAWN DISCIPLINE: every socket call here is fire-and-forget (`lvi -w
# --detach`). Stepping runs under `:silent !` with lvi's loop FROZEN waiting on
# us, so a call that awaited a reply would deadlock; a detached jump/paint
# buffers on the socket and lands when lvi resumes. lvi-list never reads the
# buffer (the cursor lives in our sidecar, its world in $LVI_* env), so it never
# needs a reply. `paint` also runs from `:on bufenter`, where the loop stays
# live. Producers that must READ the buffer self-background instead; see
# lvi-search. (contrib/README.md covers the three disciplines in full.)
#
# PREVIEW (two ways to read an entry): stepping echoes the current entry's TEXT
# (its file:line[:col]: prefix stripped) to lvi's message line via :msg --
# ephemeral, cleared by your next motion. The FULL entry (header + body) is
# `lvi-list preview` on stdout, meant for a tmux popup of the multi-line
# diagnostics:
#   map \lp :silent !tmux display-popup -E "lvi-list -w $LVI_WID preview | less -R"<CR>
# With no name, `preview` targets the LAST-STEPPED list, not the focused one, so
# `]e` steps `lint` without stealing n/N's focus yet \lp still shows the lint
# entry you just navigated to (falls back through focus if nothing's been
# stepped). Two gotchas the -E command must dodge: the popup runs under the tmux
# SERVER, which does NOT inherit lvi's exported $LVI_SOCK/$LVI_WID -- pass -w
# explicitly. And avoid $PAGER: zsh does not word-split it, so a `less -imMWR`-
# style value runs as one command name and fails -- name the pager plain.
#
# Config: LVI (client, default `lvi`), LVI_PICKER (fzf/fzy/sk, default fzf; may carry flags).
# Run from inside lvi (a map) and $LVI_WID/$LVI_SOCK are already in the env; from
# another terminal, pass `-w auto|WID`.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac

LVI=${LVI:-lvi}
PICKER=${LVI_PICKER:-fzf}

die() { echo "lvi-list: $*" >&2; exit 1; }
usage() { echo "usage: lvi-list [-w auto|WID] SUBCOMMAND [args]" >&2; exit 2; }

# ---- resolve the target view + its list directory ---------------------------
want_wid=
[ "${1:-}" = "-w" ] && { want_wid=${2:-}; [ -n "$want_wid" ] || usage; shift 2; }
sub=${1:-}; [ -n "$sub" ] || usage; shift

target=${want_wid:-${LVI_WID:-auto}}          # what we hand to `lvi -w`
if [ -n "$LVI_SOCK" ] && [ -z "$want_wid" ]; then
  sock=$LVI_SOCK                              # inside lvi: trust the exported socket
elif [ "$target" = auto ]; then
  n=$("$LVI" -l | grep -c .)
  [ "$n" = 1 ] || die "-w auto needs exactly one running view ($n found)"
  sock=$("$LVI" -l | cut -f2)
else
  sock=$("$LVI" -l | awk -F'\t' -v w="$target" '$1==w{print $2; exit}')
  [ -n "$sock" ] || die "no running view '$target'"
fi
listdir="$sock.lists"
focusfile="$sock.focus"
lastfile="$sock.last"                         # the list you most recently STEPPED (\lp preview target)

# ---- small helpers ----------------------------------------------------------
send()      { "$LVI" -w "$target" --detach -- "$@"; }         # fire-and-forget (see header)
lf()        { printf '%s\n' "$listdir/$1"; }
count()     { n=$(hdrs "$1" | grep -c .); echo "${n:-0}"; }  # number of ENTRIES (headers)
hnr()       { [ "${2:-0}" -ge 1 ] 2>/dev/null || return 0; hdrs "$1" | sed -n "${2}p"; }  # raw line of entry $2's header (0 = no entry, not sed's invalid address 0)
nth()       { r=$(hnr "$1" "$2"); [ -n "$r" ] && sed -n "${r}p" "$listdir/$1"; }  # $2's header line
etext()     { sed -E 's/^[^:]*:[0-9]+([.:][0-9]+)?(-[0-9]+([.][0-9]+)?)?:?[[:space:]]*//'; }  # entry -> its text (drop file:line[:col][-range]:)
show_cur()  { last_set "$1"; c=$(getcur "$1"); [ "$c" -ge 1 ] && send "msg $(nth "$1" "$c" | etext)"; }  # on step: mark last-stepped + preview text
getcur()    { c=$(cat "$listdir/$1.cur" 2>/dev/null); case "$c" in ''|*[!0-9]*) echo 0;; *) echo "$c";; esac; }
setcur()    { printf '%s\n' "$2" > "$listdir/$1.cur"; }
focus_get() { cat "$focusfile" 2>/dev/null; }
focus_set() { printf '%s\n' "$1" > "$focusfile"; }
last_set()  { printf '%s\n' "$1" > "$lastfile"; }                 # a step -> "the list you care about"
last_get()  { l=$(cat "$lastfile" 2>/dev/null); [ -n "$l" ] && [ -f "$listdir/$l" ] && printf '%s\n' "$l"; }
names()     { [ -d "$listdir" ] && for f in "$listdir"/*; do case "$f" in *.cur|*.cols|*.paint|"$listdir"/'*') ;; *) [ -f "$f" ] && printf '%s\n' "${f##*/}";; esac; done; }
# What this list's columns COUNT (see THE COLUMN FIELD). Unset/unknown reads as
# `byte`, which is what every producer meant before there was anywhere to say.
colunit()   { u=$(cat "$listdir/$1.cols" 2>/dev/null); case "$u" in char|display) echo "$u";; *) echo byte;; esac; }
setcols()   { if [ -n "$2" ]; then printf '%s\n' "$2" > "$listdir/$1.cols"; else rm -f "$listdir/$1.cols"; fi; }
# How this list paints (see PAINT POLICY). Unset reads as `sign`, which is what
# every producer got before there was anywhere to ask for anything else.
paintmode() { m=$(cat "$listdir/$1.paint" 2>/dev/null); case "$m" in extent|cur) echo "$m";; *) echo sign;; esac; }
setpaint()  { if [ -n "$2" ]; then printf '%s\n' "$2" > "$listdir/$1.paint"; else rm -f "$listdir/$1.paint"; fi; }

# Entry boundaries in vim's MULTI-LINE quickfix format: a `file:line[:col]:text`
# HEADER (digits right after the first colon) starts an entry; the lines after it,
# up to the next header or EOF, are its body (a compiler note, a lint detail).
#
# A header begins with the FILENAME, so its first character is never blank -- and
# that is what makes an indented body line safe. Without the leading-blank test a
# diff body carrying `-foo:12: bar` reads as a header (a leading space is a
# perfectly good filename character to `[^:]*`), and one hunk silently becomes
# three entries. Producers indent continuations; this is the half that makes the
# indenting mean something. One definition, referenced by every scan, because the
# bug above was one copy of five drifting from the contract.
#
# The filename may be EMPTY (`:12:text`), which is how a producer says "the
# buffer you are looking at, which has no file" -- lvi-search over an unsaved or
# stdin buffer. That spelling is deliberate: `jump` skips the `:e` when the
# field is blank and just moves the cursor, where a pseudo-name like `[No Name]`
# would be a filename and send lvi off to open it. So the whole name is
# optional -- but only as a whole, since a blank is fine INSIDE one (`we
# $ird.txt`) and disqualifying only at the front.
#
# After the line come GNU's other spellings of a position (4.3): `line.column`
# with a DOT, and the three ranges `line1.col1-line2.col2`, `line1.col1-col2`
# and `line1-line2`. A range is a real entry, not a malformed one -- bison emits
# every one of these -- and dropping them silently was worse than landing on the
# start, which is what jump does with one. The dot is spelled `[.]`, not `\.`:
# HDR reaches awk through -v, which eats one level of backslash (the same trap
# CANON_AWK dodges by reading $PWD from ENVIRON).
HDR='^([^:[:space:]][^:]*)?:[0-9]+([.:][0-9]+)?(-[0-9]+([.][0-9]+)?)?(:|$)'

# `hdrs` prints each header's raw line number; count/index step ENTRIES through
# it, `span` rebuilds one for `preview`.
hdrs() { awk -v hdr="$HDR" '$0 ~ hdr {print NR}' "$listdir/$1" 2>/dev/null; }
span() {                                                    # print entry $2: header + body
  s=$(hnr "$1" "$2"); [ -n "$s" ] || return 0
  e=$(hnr "$1" "$(($2 + 1))"); [ -n "$e" ] && e=$((e - 1)) || e='$'
  sed -n "${s},${e}p" "$listdir/$1"
}

# Current file: from the env when we were spawned by lvi (a map/hook), else ask.
curfile() {
  if [ -n "${LVI_FILE+x}" ]; then printf '%s\n' "$LVI_FILE"
  else "$LVI" -w "$target" -- path 2>/dev/null; fi
}

# Canonicalise a path for comparison (see MATCHING AN ENTRY TO THE BUFFER). The
# algorithm lives in awk and is shared INTO the shell rather than written twice:
# the per-entry scans below need it inside their loop, where a fork per line
# would be the whole cost of a paint. Read $PWD from ENVIRON, not -v: awk expands
# backslash escapes in a -v value, and a path may contain one.
PWD=${PWD:-$(pwd)}; export PWD
CANON_AWK='
function canon(p,   a, n, i, j, out, s) {
  if (p == "") return ""
  if (substr(p, 1, 1) != "/") p = ENVIRON["PWD"] "/" p
  n = split(p, a, "/")
  j = 0
  for (i = 1; i <= n; i++) {
    if (a[i] == "" || a[i] == ".") continue          # "//" and "/./" collapse
    if (a[i] == "..") { if (j > 0) j--; continue }   # "/.." at the root eats nothing
    out[++j] = a[i]
  }
  s = ""
  for (i = 1; i <= j; i++) s = s "/" out[i]
  return s == "" ? "/" : s
}'
canonpath() { printf '%s\n' "$1" | awk "$CANON_AWK"'{ print canon($0) }'; }

# Pull the POSITION out of a header line, in every spelling THE FORMAT accepts,
# and hand back line / col / endcol. Shared into awk the way CANON_AWK is, and
# for the same reason: the seed, the paint and `here` each scan every entry, one
# copy of the parse per scan is how the five copies of HDR drifted, and the
# number of spellings is now five. Sets p["l"] (0 = not a position, so the caller
# skips the line), p["c"] (0 = no column, meaning the whole line) and p["e"]
# (0 = no extent -- a bare column, a line range, or a range that spans lines).
POS_AWK='
function epos(s, p,   f, n, a, b, m) {
  p["l"] = 0; p["c"] = 0; p["e"] = 0
  n = split(s, f, ":")
  if (n < 2 || f[2] !~ /^[0-9]/) return 0
  m = f[2]
  b = ""
  if (split(m, a, "-") == 2) { m = a[1]; b = a[2] }   # ...-line2.col2 / ...-col2
  if (split(m, a, "[.]") == 2) { p["l"] = a[1] + 0; p["c"] = a[2] + 0 }
  else {
    p["l"] = m + 0
    if (n >= 3 && f[3] ~ /^[0-9]+$/) p["c"] = f[3] + 0   # the `file:line:col:` form
  }
  if (b != "") {
    if (split(b, a, "[.]") == 2) { if (a[1] + 0 == p["l"]) p["e"] = a[2] + 0 }
    else if (p["c"] > 0) p["e"] = b + 0                  # `line.col1-col2`
  }
  if (p["e"] < p["c"]) p["e"] = 0                        # a backwards range is no extent
  return p["l"] > 0
}'

# Jump the editor to an entry (file:line[:col]:...). Skips :e when already
# there. :pos lands exactly on the column, in whatever unit the list was put
# with (see THE COLUMN FIELD), and asks for `jump`, so stepping a list feeds the
# jumplist and the previous-context mark: Ctrl-O walks back out of a walk, and
# `''` returns to where you set off from. That is what vi does with a search and
# what vim does with a quickfix jump; a step is navigation, not a restore.
# `e -- NAME` takes the entry's filename literally (no shell expansion, nothing
# to escape).
#
# Both of GNU's position spellings are accepted: `line:col` and `line.col`. A
# range (`12.5-12.20`, `12-14`) lands on its START -- the end is the extent of
# the complaint, not a second place to put the cursor.
jump() {
  f=${1%%:*}; r=${1#*:}; ln=${r%%:*}; r=${r#*:}; c=${r%%:*}
  ln=${ln%%-*}                                   # a range lands on its start
  case "$ln" in *.*) c=${ln#*.}; ln=${ln%%.*} ;; esac   # GNU's `line.column`
  case "$c"  in ''|*[!0-9]*) c=1 ;; esac
  case "$ln" in ''|*[!0-9]*) return 0 ;; esac
  u=$(colunit "$2")
  if [ -n "$f" ] && [ "$(canonpath "$f")" != "$(canonpath "$(curfile)")" ]; then
    send "e -- $f" "pos $ln $c $u jump"
  else send "pos $ln $c $u jump"; fi
}

# Repaint NAME's entries for the CURRENT buffer, mark the current entry, and set
# the status counter. Bound to :on bufenter for cross-file lists. What a mark
# LOOKS like -- the first-cell sign, or the entry's own range -- is the list's
# recorded paint policy; see PAINT POLICY, and note that an extent needs byte
# columns, so anything else falls back to the sign here rather than mispaint.
# Un-themed groups stay invisible (opt in via :hi).
paint() {
  name=$1; [ -f "$listdir/$name" ] || return 0
  cf=$(curfile)
  mode=$(paintmode "$name"); [ "$(colunit "$name")" = byte ] || mode=sign
  lines=$(awk -F: -v cf="$cf" -v hdr="$HDR" -v mode="$mode" "$CANON_AWK$POS_AWK"'
            BEGIN { f = canon(cf) }
            $0 ~ hdr && canon($1)==f && epos($0, p) {
              if (mode == "extent" && p["e"]) printf "%s:%s-%s ", p["l"], p["c"], p["e"]
              else printf "%s:1-1 ", p["l"]
            }' "$listdir/$name")
  [ -n "$lines" ] && send "hl $name $lines" || send "hl $name"
  cur=$(getcur "$name"); total=$(count "$name")
  ce=$(nth "$name" "$cur")
  if [ -n "$ce" ] && [ "$(canonpath "${ce%%:*}")" = "$(canonpath "$cf")" ]; then
    # `cur` lights the current entry's range while the rest stay signs, which is
    # why this reads the mode separately: under `extent` it agrees with the loop
    # above, under `cur` it is the only range on screen.
    send "hl $name-cur $(printf '%s\n' "$ce" | awk -v mode="$mode" "$POS_AWK"'
            epos($0, p) {
              if (mode != "sign" && p["e"]) print p["l"] ":" p["c"] "-" p["e"]
              else print p["l"] ":1-1"
            }')"
  else send "hl $name-cur"; fi
  send "status $name [$cur/$total] $name"
}

# ---- subcommands ------------------------------------------------------------
need_name() { n=$(if [ -n "${1:-}" ]; then printf '%s\n' "$1"; else focus_get; fi); [ -n "$n" ] || die "no list (name one, or focus one first)"; printf '%s\n' "$n"; }

# A list named `x` paints the `:hl` groups `x` and `x-cur`, so a list named
# `x-cur` would be a SECOND writer on the first one's current-entry group --
# and `:hl` replaces a whole group, so the two would take turns erasing each
# other. Refuse the name at the two doors a list can come in by; there is
# nothing to gain by allowing it and no way to notice it going wrong.
check_name() { case "$1" in *-cur) die "'$1': a list may not end in -cur (it is the current-entry :hl group of '${1%-cur}')" ;; esac; }

case "$sub" in
  put)
    name=; dofocus=; atcur=; back=; cols=; pmode=
    for a in "$@"; do case "$a" in
      --focus)          dofocus=1 ;;
      --at-cursor)      atcur=1 ;;
      --at-cursor-back) atcur=1; back=1 ;;
      --cols=*)         cols=${a#--cols=} ;;
      --paint=*)        pmode=${a#--paint=} ;;
      *)                name=$a ;;
    esac; done
    [ -n "$name" ] || die "usage: lvi-list put NAME [--focus] [--at-cursor[-back]] [--cols=UNIT] [--paint=POLICY]"
    check_name "$name"
    case "$cols" in ''|byte|char|display) ;; *) die "unknown column unit: $cols (byte|char|display)" ;; esac
    case "$pmode" in ''|sign|extent|cur) ;; *) die "unknown paint policy: $pmode (sign|extent|cur)" ;; esac
    mkdir -p "$listdir"; cat > "$listdir/$name" || true       # store raw; hdrs finds the entries
    setcols "$name" "$cols"; setpaint "$name" "$pmode"
    if [ -n "$atcur" ]; then
      # Seed the index from the cursor, so the step that follows is RELATIVE to
      # where you are. Two callers, one mechanism: a REFRESHING producer (spell
      # after a fix, lint on write) seeds so `next` continues the walk instead
      # of sending it back to entry 1, and lvi-search seeds so `/` and `?` set
      # off from the cursor the way vi's do. cur = the last entry the cursor has
      # already PASSED, so `next` lands on the first one it hasn't;
      # --at-cursor-back seeds the mirror -- the first entry NOT yet passed, or
      # one past the end when every entry is behind you -- so `prev` lands on
      # the last one it has. An entry the cursor sits exactly on counts as
      # passed in both directions, which is what makes `*` and `#` step OFF the
      # word under the cursor rather than onto it.
      #
      # An entry with no column is passed the moment the cursor reaches its
      # LINE, and (going back) not until the cursor leaves it, so a col-less
      # producer like lvi-search walks line by line and neither direction can
      # land you on the line you set off from. Assumes the producer emits the
      # current file's entries in position order (ours all do); on a cross-file
      # list only the CURRENT file's entries are weighed, and the step that
      # follows may still land in another file's run.
      cf=$(curfile)
      cl=${LVI_LINE:-}; cc=${LVI_COL:-}
      [ -n "$cl" ] || { set -- $("$LVI" -w "$target" -- pos); cl=${1:-1}; cc=${2:-1}; }
      i=$(awk -F: -v cf="$cf" -v l="${cl:-1}" -v c="${cc:-1}" -v back="${back:-}" \
              -v hdr="$HDR" "$CANON_AWK$POS_AWK"'
            BEGIN { f = canon(cf) }
            $0 ~ hdr { n++
              if (canon($1) != f) next
              if (!epos($0, p)) next
              ln = p["l"]; col = p["c"] ? p["c"] : ""   # "": no column -- the whole line
              if (back == "") {
                if (ln < l+0 || (ln == l+0 && (col == "" || col <= c+0))) hit = n
              } else if (!hit) {
                if (ln > l+0 || (ln == l+0 && (col == "" || col >= c+0))) hit = n
              }
            }
            END { print back == "" ? hit+0 : (hit ? hit : n+1) }' "$listdir/$name")
      setcur "$name" "$i"
    else
      setcur "$name" 0                                        # a following `next` lands on 1
    fi
    [ -n "$dofocus" ] && focus_set "$name"
    paint "$name" ;;

  next|prev|first|last)
    # One index, four ways to move it: step it, or send it to an end (vim's
    # :cfirst / :clast). There is NO wrap -- `first`/`last` are the manual one,
    # deliberately, since a list is a walk with two ends and not a ring (the
    # deviation is lvi-search's to document, since search is where vi wraps).
    # Arriving at an end is silent; a step that RAN INTO one says so, in the
    # status segment beside nfile/pfile's "(no more files)" rather than on the
    # message line, which is busy showing the entry show_cur just previewed.
    name=$(need_name "${1:-}") || exit 1; total=$(count "$name")
    [ "$total" -gt 0 ] || die "$name is empty"
    cur=$(getcur "$name")
    case "$sub" in
      next)  cur=$((cur+1)) ;;  prev) cur=$((cur-1)) ;;
      first) cur=1 ;;           last) cur=$total ;;
    esac
    edge=
    [ "$cur" -lt 1 ]        && { cur=1;       edge=" (start)"; }
    [ "$cur" -gt "$total" ] && { cur=$total;  edge=" (end)"; }
    setcur "$name" "$cur"; jump "$(nth "$name" "$cur")" "$name"; paint "$name"
    [ -n "$edge" ] && send "status $name [$cur/$total] $name$edge"
    show_cur "$name" ;;

  nfile|pfile)
    name=$(need_name "${1:-}") || exit 1; total=$(count "$name")
    [ "$total" -gt 0 ] || die "$name is empty"
    cur=$(getcur "$name"); [ "$cur" -ge 1 ] || cur=1
    # Entry-to-entry, so raw: one list comes from one producer and spells a given
    # file one way. Only entry-vs-BUFFER needs canonpath, and it would cost a
    # fork per entry here.
    curf=$(nth "$name" "$cur"); curf=${curf%%:*}
    dir=1; [ "$sub" = pfile ] && dir=-1
    i=$cur; target_i=
    while :; do
      i=$((i+dir)); [ "$i" -lt 1 ] && break; [ "$i" -gt "$total" ] && break
      ef=$(nth "$name" "$i"); ef=${ef%%:*}
      [ "$ef" != "$curf" ] && { target_i=$i; break; }
    done
    [ -n "$target_i" ] || { send "status $name [$cur/$total] $name (no more files)"; exit 0; }
    setcur "$name" "$target_i"; jump "$(nth "$name" "$target_i")" "$name"; paint "$name"; show_cur "$name" ;;

  here)
    name=$(need_name "${1:-}") || exit 1; [ -f "$listdir/$name" ] || die "$name is empty"
    cf=$(curfile); cl=${LVI_LINE:-$("$LVI" -w "$target" -- pos | cut -f1)}
    i=$(awk -F: -v cf="$cf" -v l="$cl" -v hdr="$HDR" "$CANON_AWK$POS_AWK"'
          BEGIN { f = canon(cf) }
          $0 ~ hdr { n++; if (canon($1)==f && epos($0, p) && p["l"]>=(l+0)) { print n; exit } }' "$listdir/$name")
    [ -n "$i" ] || i=1
    setcur "$name" "$i"; jump "$(nth "$name" "$i")" "$name"; paint "$name"; show_cur "$name" ;;

  current|cc)
    # Re-jump to the CURRENT entry without stepping (vim's :cc). The recall for
    # "n landed me on a closed fold, I opened it (zo/zO), now put me on the match":
    # the jump re-runs against the now-open fold, so the cursor lands on the line
    # + column instead of snapping to the fold head. Also recovers from a
    # cross-file re-fold (an `on bufenter lvi-fold` that re-closed the fold).
    name=$(need_name "${1:-}") || exit 1; [ -f "$listdir/$name" ] || die "$name is empty"
    cur=$(getcur "$name"); [ "$cur" -ge 1 ] || die "not stepped into $name yet"
    jump "$(nth "$name" "$cur")" "$name"; paint "$name"; show_cur "$name" ;;

  preview)                                   # the full current entry (header + body) to stdout
    # Default to the LAST-STEPPED list, not the focused one: `]e` steps lint
    # without stealing n/N's focus, yet \lp should still show the lint entry you
    # just navigated to. Fall back through focus when nothing's been stepped.
    name=${1:-$(last_get)}; [ -n "$name" ] || name=$(focus_get)
    [ -n "$name" ] || die "no list stepped yet (step one, or name it)"
    [ -f "$listdir/$name" ] || die "$name is empty"
    cur=$(getcur "$name"); [ "$cur" -ge 1 ] || die "$name: step into the list first"
    span "$name" "$cur" ;;

  goto)
    name=$(need_name "${1:-}") || exit 1; [ -f "$listdir/$name" ] || die "$name is empty"
    # "N: file:line:..." -- a self-contained line the index is parsed back off,
    # so any $LVI_PICKER works: no fzf-only --with-nth/--delimiter (fzy, a plain
    # line filter, rejects them). The visible index just numbers the entries.
    sel=$(awk -v hdr="$HDR" '$0 ~ hdr {printf "%d: %s\n", ++n, $0}' "$listdir/$name" \
            | $PICKER) || exit 0
    i=${sel%%:*}
    [ -n "$i" ] && { setcur "$name" "$i"; jump "$(nth "$name" "$i")" "$name"; paint "$name"; show_cur "$name"; } ;;

  switch)
    name=$(names | $PICKER) || exit 0
    [ -n "$name" ] && { focus_set "$name"; paint "$name"; } ;;

  focus)
    if [ -n "${1:-}" ]; then focus_set "$1"; paint "$1"; else focus_get; fi ;;

  paint)                                     # :on bufenter -> repaint all lists
    if [ -n "${1:-}" ]; then paint "$1"; else names | while IFS= read -r nm; do paint "$nm"; done; fi ;;

  ls)
    f=$(focus_get); names | while IFS= read -r nm; do
      mark=" "; [ "$nm" = "$f" ] && mark="*"
      printf '%s %s\t%s\n' "$mark" "$(count "$nm")" "$nm"
    done ;;

  save) name=${1:?usage: save NAME PATH}; dest=${2:?usage: save NAME PATH}; cp "$listdir/$name" "$dest" ;;
  load)
    src=${1:?usage: load PATH [NAME] [--focus] [--cols=UNIT] [--paint=POLICY]}
    name=${2:-$(basename "$src")}; case "$name" in --focus|--cols=*|--paint=*) name=$(basename "$src");; esac
    check_name "$name"
    cols=; pmode=; for a in "$@"; do case "$a" in --cols=*) cols=${a#--cols=} ;; --paint=*) pmode=${a#--paint=} ;; esac; done
    case "$cols" in ''|byte|char|display) ;; *) die "unknown column unit: $cols (byte|char|display)" ;; esac
    case "$pmode" in ''|sign|extent|cur) ;; *) die "unknown paint policy: $pmode (sign|extent|cur)" ;; esac
    mkdir -p "$listdir"; cp "$src" "$listdir/$name" || true; setcur "$name" 0
    setcols "$name" "$cols"; setpaint "$name" "$pmode"
    case " $* " in *" --focus "*) focus_set "$name" ;; esac
    paint "$name" ;;

  drop|clear|hide)
    # All three unpaint (clear the :hl groups + status); they differ in what they
    # do to the stored list: drop removes it, clear empties it, hide keeps it
    # whole (cursor + focus intact) so `n`/`N` re-show it -- a per-list :nohl.
    name=$(need_name "${1:-}") || exit 1
    case "$sub" in
      drop)  rm -f "$listdir/$name" "$listdir/$name.cur" "$listdir/$name.cols" "$listdir/$name.paint" ;;
      clear) : > "$listdir/$name"; setcur "$name" 0 ;;
      hide)  : ;;
    esac
    send "hl $name"; send "hl $name-cur"; send "status $name" ;;

  path) name=${1:?usage: path NAME}; printf '%s\n' "$listdir/$name" ;;

  *) usage ;;
esac
