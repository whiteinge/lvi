#!/bin/sh
# lvi-match [-w auto|WID] [add|del|list|clear|scan] [...] -- sticky pattern marks.
#
# Vim's `matchadd()`/`matchdelete()`: keep a set of patterns painted in the
# buffer until you take them away. `/` (lvi-search) answers "where is the next
# one"; a match answers "where are all of these, while I read" -- the three
# identifiers you are tracing through a function, a TODO marker. Patterns are
# stored per view and re-scanned as you type, so a mark lands on text you have
# not saved, or even finished typing.
#
#   lvi-match [add] [-i] [-F] [--word] [-g GROUP] [PATTERN]
#                         add a pattern (prompts when PATTERN is omitted)
#   lvi-match del [ID]    remove one pattern (default: the newest)
#   lvi-match list        print the active patterns: ID, group, flags, pattern
#   lvi-match clear       remove them all (vim's clearmatches())
#   lvi-match scan        re-paint now (the hook target; a no-op with no patterns)
#
# `add` is implied, so `lvi-match TODO` marks a pattern and a bare `lvi-match`
# prompts for one -- at the cost that a mistyped subcommand is read as a
# pattern rather than refused (the message line names what it added).
#
# PATTERN is a POSIX BRE, the same dialect as vi's `/` and lvi-search's. `-F`
# takes PATTERN literally (it escapes the BRE metacharacters for you), `--word`
# keeps only matches with a non-word byte on both sides (grep's -w, and what makes
# `*` on the cursor word behave), and `-i` folds case.
#
# THE MATCHER is `lvi-bre-locate`, the backend lvi-search uses in both of its
# shapes: a mark needs a column RANGE, and it is the thing that reports one
# without leaving vi's dialect (it marks each match with sed and counts the
# offsets). These patterns used to be POSIX EREs, because awk's
# `match()`/RSTART/RLENGTH was the only column-reporting tool in reach -- which
# meant every pattern you typed at `\hm` was in a different dialect from every
# pattern you typed at `/`. See its header for the mechanism, the whole-word
# test, the case-folding fallback and the exit codes.
#
# ONE LOCATE PER PATTERN, not one pass with N substitutions. Marking is
# destructive to the text the next pattern would read: mark `ab` in `abc` and a
# following `bc` no longer matches, because two marker bytes now sit inside it.
# That failure is silent, so the patterns get separate passes over the buffer and
# the results are merged afterwards. Cost is a locate per pattern per scan, which
# is why the buffer cap below matters more than the pattern count.
#
# GROUPS AND COLOR: each pattern paints one `:hl` group, and successive adds
# take `match1`, `match2`, ... so several patterns read apart at a glance (the
# lowest free number is reused after a del; past `match6` they share). `-g`
# picks the group by hand -- two patterns in one group merge into one color,
# which is how you mark a family. An un-themed group is invisible (see
# CLAUDE.md), so the FIRST add of a view pushes a default palette for
# `match1`-`match6` at `pri=12`, above syntax (0) and search (10). That push
# lands after the rc has run, so an rc `hi match1` loses. Two ways out:
# LVI_MATCH_STYLES holds the palette as `;`-separated `hi` specs, one per group,
# so set it to your own -- or blank it in the add bindings and theme the groups
# in the rc (`:bg` and `:silent !` take a shell line, so
# `map \hm :bg LVI_MATCH_STYLES= lvi-match add ...`).
#
# SCAN OWNS THE HOOKS, NOT THE RC: `:on` hooks compose by appending and a bare
# `:on change` clears EVERYONE's, so a tool cannot uninstall just its own. The
# first add installs `on change lvi-match scan` (and its bufenter twin, so the
# marks follow a buffer switch) ONCE per view, and the hooks stay; `scan` exits
# instantly while no pattern is set. Do NOT also add these hooks to your rc.
# State lives beside the socket, disposable with the view (the lvi-list
# pattern):
#   $LVI_SOCK.match          the patterns, one ID<TAB>GROUP<TAB>FLAGS<TAB>PATTERN
#   $LVI_SOCK.match.hooked   the once-per-view hook marker
#   $LVI_SOCK.match.styled   the once-per-view palette marker
#
# Bindings (rc) -- the highlight menu \h already holds lvi-highlight's \hh/\ht:
#     map \hm :bg lvi-match add --word -F "$LVI_CWORD"<CR>  " mark the cursor word
#     map \hp :silent !lvi-match<CR>                        " prompt for a pattern
#     map \hd :bg lvi-match del<CR>                         " drop the newest mark
#     map \hc :bg lvi-match clear<CR>                       " drop them all
#     map \hl :!lvi-match list<CR>                          " what is marked
#
# SPAWN DISCIPLINES: every subcommand that re-paints self-backgrounds a
# --worker, because reading the buffer needs lvi's event loop (the same reason
# as lvi-highlight) and a `:silent !` binding has it frozen -- so any binding is
# safe. Only the pattern PROMPT runs in the foreground, where `:!` handed us the
# tty; bind that one `:silent !`, the rest `:bg` (no terminal handover, so no
# alt-screen flash).
#
# The marks are view-wide, not per-buffer: switch buffers and the same patterns
# paint the new one. Matches are byte columns, and the buffer is capped (a
# pathological pattern is capped too -- past LVI_MATCH_MAXHITS the rest of that
# pattern goes unpainted and the message line says so). A zero-width match
# (`x*`) paints nothing rather than hanging. Under `-i` a case-distinguishing
# bracket expression loses its meaning, which is the point of asking for it. A
# socket-side edit (lvi-fmt, a filter) leaves the marks stale until your next
# keystroke; `lvi-match scan` re-paints on demand. A buffer holding either marker
# byte (a binary file) cannot be scanned at all -- the columns would be wrong --
# so the scan stops and says so on the status line rather than painting nonsense.
#
# Config: LVI (client, default `lvi`), LVI_MATCH_STYLES (the default palette;
# empty pushes none), LVI_MATCH_MAXBYTES (skip buffers larger than this, default
# 262144), LVI_MATCH_MAXHITS (per-pattern paint cap, default 5000),
# LVI_MATCH_DEBUG (file to capture worker stderr). Needs lvi-bre-locate on PATH.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac
LVI=${LVI:-lvi}
MAXBYTES=${LVI_MATCH_MAXBYTES:-262144}
MAXHITS=${LVI_MATCH_MAXHITS:-5000}
TAB=$(printf '\t')
# The default look of match1..matchN: `;`-separated `hi` specs, positional.
PALETTE='bg=yellow fg=black pri=12;bg=cyan fg=black pri=12;bg=green fg=black pri=12'
PALETTE="$PALETTE;bg=magenta fg=black pri=12;bg=blue fg=white pri=12;bg=red fg=white pri=12"

# Errors also land on the target's status line: stderr is discarded (:bg) or
# repainted over (:silent !) under every documented binding.
die() {
  echo "lvi-match: $*" >&2
  [ -n "${target:-}" ] && "$LVI" -w "$target" --detach -- "msge lvi-match: $*" 2>/dev/null
  exit 1
}

worker=; [ "${1:-}" = "--worker" ] && { worker=1; shift; }
notify=; [ "${1:-}" = "--notify" ] && { notify=${2:-}; shift 2; }
want_wid=; [ "${1:-}" = "-w" ] && { want_wid=${2:-}; shift 2; }
sub=add; [ $# -gt 0 ] && { sub=$1; shift; }
target=${want_wid:-${LVI_WID:-auto}}
wflag=; [ -n "$want_wid" ] && wflag="-w $want_wid"

# The socket path anchors our state files; resolve it the way lvi-list does.
if [ -n "${LVI_SOCK:-}" ] && [ -z "$want_wid" ]; then
  sock=$LVI_SOCK                      # inside lvi: trust the exported socket
elif [ "$target" = auto ]; then
  n=$("$LVI" -l | grep -c .)
  [ "$n" = 1 ] || die "-w auto needs exactly one running view ($n found)"
  sock=$("$LVI" -l | cut -f2)
else
  sock=$("$LVI" -l | awk -F'\t' -v w="$target" '$1==w{print $2; exit}')
  [ -n "$sock" ] || die "no running view '$target'"
fi
state="$sock.match"
hooked="$sock.match.hooked"
styled="$sock.match.styled"

send() { "$LVI" -w "$target" --detach -- "$@"; }   # fire-and-forget (see header)

# ---- worker: the actual scan (runs with lvi's loop live) ---------------------
if [ -n "$worker" ]; then
  [ -s "$state" ] || exit 0           # cleared while we were queued
  tdir=${sock%/*}; [ -n "$tdir" ] && [ -d "$tdir" ] || tdir=${TMPDIR:-/tmp}
  buf=$(mktemp "$tdir/lvi-match.buf.XXXXXX")  || die "cannot make a temp file"
  hitsf=$(mktemp "$tdir/lvi-match.hits.XXXXXX") || die "cannot make a temp file"
  trap 'rm -f "$buf" "$hitsf"' EXIT HUP INT TERM

  # To a file, not a variable: lvi-bre-locate reads the buffer twice (the
  # original lines for a column and for --word, then the marked stream), and a
  # variable would lose the trailing blank lines that `$(...)` strips.
  "$LVI" -w "$target" -- '%p' > "$buf" || die "cannot read view $target"
  nbytes=$(wc -c < "$buf")
  if [ "$nbytes" -gt "$MAXBYTES" ]; then
    echo "lvi-match: ${nbytes}B over cap ${MAXBYTES}B; skipping (raise LVI_MATCH_MAXBYTES)" >&2
    send "status match [lvi-match off: over ${MAXBYTES}B cap]"
    exit 0
  fi

  : > "$hitsf"
  while IFS="$TAB" read -r id grp fl pat; do
    [ -n "$id" ] && [ -n "$grp" ] || continue
    iflag=; case $fl in *i*) iflag=-i ;; esac
    wflagm=; case $fl in *w*) wflagm=--word ;; esac
    # One locate per pattern (see ONE SED PASS PER PATTERN). It hands back
    # LINE<TAB>COL<TAB>LEN per occurrence, in vi's BRE, with the whole-word test
    # and the case-folding fallback already applied.
    hits=$(lvi-bre-locate $iflag $wflagm -- "$pat" "$buf" 2>/dev/null)
    case $? in
      0) ;;
      # A marker byte in the BUFFER: every column past it would be wrong, so the
      # whole scan stops rather than painting nonsense (a binary file, in
      # practice). Loudly, since the marks silently vanishing is worse.
      3) send "status match [lvi-match off: marker bytes in buffer]"; exit 0 ;;
      # A pattern sed rejects paints nothing and says nothing: `add` already
      # refused it, so reaching this is a state file edited by hand.
      *) continue ;;
    esac
    # id<TAB>group<TAB>line<TAB>start<TAB>end, one line per hit. The cap, the
    # counting and the notice all live in the merge below, so this stays a
    # matcher and nothing else. A zero-width match has no cell to paint, so `x*`
    # marks nothing.
    printf '%s\n' "$hits" | LC_ALL=C awk -F"$TAB" -v id="$id" -v grp="$grp" \
      '$3 > 0 { printf "%s\t%s\t%d\t%d\t%d\n", id, grp, $1, $2, $2 + $3 - 1 }' >> "$hitsf"
  done < "$state"

  # Merge: the state first (FNR==NR) so every group it names gets an `hl` even
  # when it matched nothing -- that empty paint is what CLEARS it, the same
  # branch, no special case -- then the hits.
  set --
  while IFS= read -r cmd; do [ -n "$cmd" ] && set -- "$@" "$cmd"; done <<EOF
$(LC_ALL=C awk -F"$TAB" -v cap="$MAXHITS" -v notify="$notify" '
    FNR == NR {                                       # a state line
      k++; ID[k] = $1; G[k] = $2; P[k] = $4
      seen[$2] = 1
      next
    }
    {
      hits[$1]++
      # Hits are counted past the cap even though they stop being painted, so
      # the status total stays honest about what is out there.
      if (hits[$1] <= cap) R[$2] = R[$2] sprintf(" %d:%d-%d", $3, $4, $5)
      else over[$1] = 1
    }
    END {
      for (g in seen) printf "hl %s%s\n", g, R[g]
      tot = 0; ov = 0
      for (j = 1; j <= k; j++) { tot += hits[ID[j]]; if (over[ID[j]]) ov = 1 }
      printf "status match [match %d: %d]\n", k, tot
      # The just-added pattern reports itself -- an add that matches nothing
      # would otherwise be indistinguishable from a mark you cannot see.
      for (j = 1; j <= k; j++)
        if (notify != "" && ID[j] == notify) {
          if (hits[ID[j]]) printf "msg match /%s/ %d (%s)\n", P[j], hits[ID[j]], G[j]
          else printf "msge match /%s/ no match\n", P[j]
        }
      if (ov) printf "msge match: over %d hits, rest unpainted (LVI_MATCH_MAXHITS)\n", cap
    }' "$state" "$hitsf")
EOF
  # No commands means awk itself failed (the state vanished under us, say) --
  # sending nothing beats sending an empty request.
  [ $# -gt 0 ] && "$LVI" -w "$target" -- "$@"
  exit 0
fi

# ---- subcommands -------------------------------------------------------------
# Detach the buffer-reading half; return at once so lvi's loop resumes and can
# service the worker's socket traffic.
match_scan() {
  [ -s "$state" ] || return 0               # the gate that makes the hooks no-ops
  ( "$0" --worker ${1:+--notify} ${1:+$1} $wflag >"${LVI_MATCH_DEBUG:-/dev/null}" 2>&1 & )
}

# Clear every group we currently paint. Used before a del/clear edits the state:
# a group that leaves the state is never named again, so the scan that follows
# cannot clear it -- only this can.
match_unpaint() {
  [ -s "$state" ] || return 0
  set --
  for g in $(cut -f2 "$state" | sort -u); do set -- "$@" "hl $g"; done
  [ $# -gt 0 ] && send "$@"
}

# The default palette, once per view. It lands AFTER the rc has run, so it wins
# over an rc `hi match1 ...`; setting LVI_MATCH_STYLES empty is how you keep the
# rc's colors (see the header).
match_style() {
  [ -f "$styled" ] && return 0
  : > "$styled"
  styles=${LVI_MATCH_STYLES-$PALETTE}
  [ -n "$styles" ] || return 0
  set --
  n=1
  while [ -n "$styles" ]; do
    spec=${styles%%;*}
    case $styles in *";"*) styles=${styles#*;} ;; *) styles= ;; esac
    [ -n "$spec" ] && set -- "$@" "hi match$n $spec"
    n=$((n + 1))
  done
  [ $# -gt 0 ] && send "$@"
}

match_add() {
  icase= fixed= word= grp=
  while [ $# -gt 0 ]; do
    case $1 in
      -i)     icase=1; shift ;;
      -F)     fixed=1; shift ;;
      --word) word=1; shift ;;
      -g)     grp=${2:-}; [ -n "$grp" ] || die "-g needs a group name"; shift 2 ;;
      --)     shift; break ;;
      -?*)    die "unknown flag '$1' (-i -F --word -g GROUP)" ;;
      *)      break ;;
    esac
  done
  pat=${1:-}

  # Prompt in the foreground (where `:!` handed us the tty). Skipped when a
  # pattern was supplied, e.g. the \hm map passing $LVI_CWORD.
  if [ -z "$pat" ]; then
    [ -t 0 ] || die "no pattern, and no tty to prompt on (bind :silent !lvi-match)"
    printf 'match/' >&2
    IFS= read -r pat || exit 0
    [ -n "$pat" ] || exit 0
  fi
  # BRE metacharacters only: escaping an ERE's would be actively wrong here,
  # since GNU BRE reads `\+` and `\?` as the operators `+` and `?` are not.
  [ -n "$fixed" ] && pat=$(printf '%s\n' "$pat" | sed 's/[][\\^$.*]/\\&/g')
  # A bad BRE would paint nothing and say nothing from inside the worker, so
  # reject it here, where there is someone to tell. `PATTERN /dev/null` is
  # lvi-bre-locate's validate-only call: it runs every check against no input.
  lvi-bre-locate -- "$pat" /dev/null 2>/dev/null
  case $? in
    0) ;;
    4) die "pattern holds a marker byte the matcher uses" ;;
    *) die "bad pattern /$pat/" ;;
  esac

  # The lowest free matchN, so a del frees its color for the next add; past six
  # they share a group (and a color) rather than going invisible.
  if [ -z "$grp" ]; then
    n=1
    while [ "$n" -le 6 ]; do
      cut -f2 "$state" 2>/dev/null | grep -qx "match$n" || break
      n=$((n + 1))
    done
    [ "$n" -le 6 ] || n=$(( ($(cut -f1 "$state" | wc -l) % 6) + 1 ))
    grp=match$n
  fi
  id=$({ echo 0; cut -f1 "$state" 2>/dev/null; } | sort -n | tail -1)
  id=$((id + 1))
  fl=; [ -n "$icase" ] && fl="${fl}i"; [ -n "$word" ] && fl="${fl}w"; [ -z "$fl" ] && fl=-
  printf '%s\t%s\t%s\t%s\n' "$id" "$grp" "$fl" "$pat" >> "$state" || die "cannot write $state"

  if [ ! -f "$hooked" ]; then               # once per view; the hooks then stay
    send 'on change lvi-match scan' 'on bufenter lvi-match scan'
    : > "$hooked"
  fi
  match_style
  match_scan "$id"
}

match_del() {
  [ -s "$state" ] || { send 'msge match: nothing to delete'; return 0; }
  id=${1:-$(cut -f1 "$state" | sort -n | tail -1)}
  grep -q "^$id$TAB" "$state" || die "no match '$id' (lvi-match list)"
  match_unpaint                             # before the state loses the group
  tmp="$state.$$"
  grep -v "^$id$TAB" "$state" > "$tmp"
  mv "$tmp" "$state"
  if [ -s "$state" ]; then
    match_scan                              # repaint the survivors
  else
    rm -f "$state"
    send 'status match' 'msg match cleared'
  fi
}

match_clear() {
  match_unpaint
  rm -f "$state"
  send 'status match' 'msg match cleared'
}

match_list() {
  [ -s "$state" ] || { echo "no matches"; return 0; }
  while IFS="$TAB" read -r id grp fl pat; do
    printf '%s\t%s\t%s\t/%s/\n' "$id" "$grp" "$fl" "$pat"
  done < "$state"
}

case "$sub" in
  add)   match_add "$@" ;;
  del)   match_del "$@" ;;
  clear) match_clear ;;
  list)  match_list ;;
  scan)  match_scan ;;
  *)     match_add "$sub" "$@" ;;           # `lvi-match TODO`, `lvi-match -i foo`
esac
