#!/bin/sh
# lvi-motion-search [-b] [--word] [--last] TMPFILE COUNT LINE COL ARG
#
# Search as a MOTION, for lvi's `:motion` seam -- the half of search that a list
# cannot be. `lvi-search` builds a list you walk, which is the right shape for
# "show me all of them" and the wrong one for `d/foo`: an operator needs its
# target back before the command finishes, and a list arrives over the socket
# afterwards. This is a synchronous filter instead: the editor writes the buffer
# to TMPFILE, runs us, and reads one line. Wire it up in the rc:
#
#     motion / prompt lvi-motion-search              " /pattern
#     motion ? prompt lvi-motion-search -b           " ?pattern
#     motion n lvi-motion-search --last              " next
#     motion N lvi-motion-search --last -b           " previous
#     motion * lvi-motion-search --word              " the word under the cursor
#     motion # lvi-motion-search --word -b
#
# Then `/` moves, `d/foo` deletes up to the match, `y?bar` yanks back to one,
# `n`/`N` repeat, and every one of them is jump-class, so Ctrl-O and `` come
# back. See lvi(1) `motion` for the contract; the arguments above are the
# editor's, the flags are ours.
#
# PATTERN is a POSIX BRE, vi's own dialect, matched by the same sed marker pass
# lvi-search and lvi-match use: `s///g` with `&` wraps each leftmost-longest
# match in a control byte and awk counts the offsets. Two bytes do it -- 0x01
# marks, 0x02 delimits the `s` command, so a pattern never needs escaping.
#
# WHICH MATCH: the COUNTth one strictly PAST the cursor, so `/` never lands where
# you already are and `3/foo` skips two. `-b` mirrors it. Unlike lvi-search's
# list, this WRAPS -- vi's `wrapscan`, on by default -- because a motion that
# stops dead at the end of the buffer is not the motion vi has. The target is
# EXCLUSIVE, also vi's: `d/foo` stops before the match rather than eating it.
#
# THE LAST PATTERN is ours to keep, which is what makes `n` more than a stale
# snapshot: it re-runs the matcher against the buffer as it is now. It lives in
# `$LVI_SOCK.motion-search` (the socket is in our environment; the rest of the
# $LVI_* set is refreshed only for hooks, so position comes from argv). An empty
# ARG reuses it too, so a bare `/<CR>` repeats the last search the way vi's does.
#
# `--word` takes the word under the cursor and keeps only whole-word matches --
# grep's -w, and what makes `*` behave. The boundary test is ours rather than
# `\<`/`\>`, which are GNU-only.
#
# Config: none. Needs sed and awk, and nothing else.

case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac

back= word= last=
while [ $# -gt 5 ]; do
  case $1 in
    -b|--back) back=1; shift ;;
    --word)    word=1; shift ;;
    --last)    last=1; shift ;;
    *)         break ;;
  esac
done
[ $# -eq 5 ] || { echo "err lvi-motion-search: bad arguments"; exit 0; }
tmpf=$1 count=$2 cl=$3 cc=$4 arg=$5
store=${LVI_SOCK:+$LVI_SOCK.motion-search}

M=$(printf '\001'); D=$(printf '\002')

# The pattern, from one of three places. `--word` reads it off the buffer; --last
# and an empty prompt read the one we kept; otherwise it is what was typed.
if [ -n "$word" ]; then
  pat=$(LC_ALL=C awk -v l="$cl" -v c="$cc" 'NR == l {
          s = $0
          # Walk out from the cursor byte to the word edges (vi word bytes).
          if (substr(s, c, 1) !~ /[[:alnum:]_]/) exit
          a = c; while (a > 1 && substr(s, a - 1, 1) ~ /[[:alnum:]_]/) a--
          b = c; while (b < length(s) && substr(s, b + 1, 1) ~ /[[:alnum:]_]/) b++
          print substr(s, a, b - a + 1)
        }' "$tmpf")
  [ -n "$pat" ] || { echo "err no word under the cursor"; exit 0; }
elif [ -n "$last" ] || [ -z "$arg" ]; then
  [ -n "$store" ] && [ -f "$store" ] || { echo "err no previous search"; exit 0; }
  word=$(sed -n 1p "$store"); pat=$(sed -n '2,$p' "$store")
  [ -n "$pat" ] || { echo "err no previous search"; exit 0; }
else
  pat=$arg
fi
case $pat in *"$M"*|*"$D"*) echo "err pattern holds a control byte"; exit 0 ;; esac

# Validate against EMPTY input -- sed parses the whole script before it reads a
# byte, so a bad BRE is caught without touching the buffer.
prog="s${D}${pat}${D}${M}&${M}${D}g"
printf '' | sed "$prog" >/dev/null 2>&1 || { echo "err bad pattern: $pat"; exit 0; }

# Remember it (word-ness first, so `n` after `*` stays a word search). Only when
# this search came from outside -- re-storing what --last just read is a no-op,
# but writing on every `n` would churn the file for nothing.
if [ -z "$last" ] && [ -n "$store" ]; then
  printf '%s\n%s\n' "${word:-}" "$pat" > "$store" 2>/dev/null || :
fi

sed "$prog" "$tmpf" > "$tmpf.mk" 2>/dev/null || { echo "err bad pattern: $pat"; exit 0; }
LC_ALL=C awk -v m="$M" -v back="$back" -v word="$word" -v n="$count" \
             -v cl="$cl" -v cc="$cc" '
  NR == FNR { o[FNR] = $0; next }                 # the original lines
  index($0, m) {
    rest = $0; seen = 0
    while ((i = index(rest, m)) > 0) {
      seen += i - 1                               # real text before the mark
      c = seen + 1
      rest = substr(rest, i + 1)
      j = index(rest, m)
      if (j == 0) break                           # unpaired: leave the line
      len = j - 1; seen += len
      rest = substr(rest, j + 1)
      if (len < 1) continue                       # zero-width: nowhere to land
      if (word) {                                 # whole words only (grep -w)
        if (c > 1 && substr(o[FNR], c - 1, 1) ~ /[[:alnum:]_]/) continue
        if (substr(o[FNR], c + len, 1) ~ /[[:alnum:]_]/) continue
      }
      k++; L[k] = FNR; C[k] = c
    }
  }
  END {
    if (!k) { print "err pattern not found"; exit }
    # The COUNTth match past the cursor, wrapping at the end -- vi wrapscan. The
    # list is in buffer order, so forward walks it up from the first match past
    # the cursor and backward walks it down from the last one before.
    step = back ? -1 : 1
    start = 0
    if (!back) { for (i = 1; i <= k; i++) if (L[i] > cl || (L[i] == cl && C[i] > cc)) { start = i; break }
                 if (!start) start = 1 }                       # everything is behind: wrap
    else       { for (i = k; i >= 1; i--) if (L[i] < cl || (L[i] == cl && C[i] < cc)) { start = i; break }
                 if (!start) start = k }                       # everything is ahead: wrap
    idx = start + (n - 1) * step
    # Wrap the count too, so 5/foo in a three-match buffer keeps going round.
    idx = ((idx - 1) % k + k) % k + 1
    printf "char %d %d\n", L[idx], C[idx]
  }' "$tmpf" "$tmpf.mk"
rm -f "$tmpf.mk"
