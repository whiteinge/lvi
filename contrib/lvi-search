#!/bin/sh
# lvi-search [-w auto|WID] [-i] [-b] [PATTERN]
#
# Search a running lvi from outside it, as a `lvi-list` producer: grep the *live*
# buffer over the control socket, build the `search` list, focus it, and jump to
# the first match past the cursor. `n`/`N` then step it like any other list --
# search is just a degenerate quickfix. Because it reads the buffer via `%p` it searches UNSAVED
# content, and the line numbers map straight back. PATTERN is a POSIX BRE, vi's
# own dialect.
#
# Bind it inside lvi (WID comes from $LVI_WID). `/` prompts, so it needs the tty
# (`:silent !`); the rest touch no tty, so they use `:bg` -- a detached spawn with
# no terminal handover, which avoids the alt-screen flash when you hold n/N:
#     map / :silent !lvi-search<CR>             " prompt for a pattern
#     map ? :silent !lvi-search -b<CR>          " ...searching backward
#     map * :bg lvi-search "$LVI_CWORD"<CR>     " search the word under the cursor
#     map # :bg lvi-search -b "$LVI_CWORD"<CR>  " ...backward
#     map n :bg lvi-list next<CR>               " step the focused list
#     map N :bg lvi-list prev<CR>
# From another terminal, pass a WID: `lvi-search -w auto foo`.
#
# WHERE A SEARCH STARTS: at the cursor, as vi's does. The list is seeded from
# the cursor position (`lvi-list put --at-cursor`) and then stepped, so the
# first hop lands on the match AFTER the cursor rather than at the top of the
# file. `-b` is the backward search, vi's `?` and `#`: the mirror seed, then a
# step back. A search that ignored the cursor would just be a project-wide grep
# narrowed to one file, which is a different tool.
#
# THE MATCHER, and why it is not grep. Entries carry the match's EXTENT
# (`file:LINE.C1-C2:`), one per OCCURRENCE, so a second match further along a
# line is its own stop, the seed can resume from between two matches on one line,
# and `--paint=extent` lights the match itself. Finding that is `lvi-bre-locate`,
# the shared backend: it speaks vi's BRE and reports POSITIONS, which no single
# obvious tool does (grep will not say where a match sits, awk speaks ERE), by
# marking each match with sed and counting the offsets. It hands back
# LINE<TAB>COL<TAB>LEN per occurrence and we shape those into entries; see its
# header for the mechanism, the case-folding fallback and the exit codes.
#
# Two limits, both loud rather than silent: a zero-width match (`o*`, `^`) has no
# extent, so it lands as a bare `LINE.COL` entry; and a marker byte in the
# pattern or in the buffer -- a binary file, in practice -- falls back to `grep
# -n`, whose per-line entries are what this script emitted before. (See
# contrib/lvi-list for the entry format and who reads a column.)
#
# TWO DEVIATIONS FROM VI, both from search being a list you walk rather than a
# motion the editor repeats:
#   * No WRAPSCAN. A list is a walk with two ends, not a ring, so `n` stops on
#     the last match -- the status segment says `(end)` -- instead of resuming
#     from the top. `lvi-list first`/`last` are the wrap, done by hand.
#   * `n` does not inherit the DIRECTION of the last search. n/N are plain
#     `lvi-list next`/`prev` and a list remembers only its index, not which way
#     it was seeded, so after a `?` it is `N` that keeps going backward.
#
# It self-backgrounds a --worker: reading the buffer needs lvi's event loop,
# which is frozen while this `:silent !` child runs, so a foreground read would
# deadlock (same reason lvi-highlight self-backgrounds). The pattern PROMPT,
# though, runs in the foreground -- a backgrounded worker has no tty.
#
# Case: -i forces case-insensitive; LVI_SEARCH_CASE picks the default policy --
# `sensitive` (default), `ignore`, or `smart` (the vi/vim rule: insensitive unless
# PATTERN has an uppercase letter). Set it per binding to taste, e.g.
#     map / :silent !LVI_SEARCH_CASE=smart lvi-search<CR>
# How the folding is done (sed's `I` flag where there is one, `tr` where there is
# not) is lvi-bre-locate's business, not ours.
#
# Config: LVI (client, default `lvi`), LVI_SEARCH_CASE (sensitive|ignore|smart),
# LVI_SEARCH_DEBUG (capture worker stderr). Needs lvi-list and lvi-bre-locate on
# PATH.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac
LVI=${LVI:-lvi}

worker= want_wid= icase= back= pat=
while [ $# -gt 0 ]; do
  case $1 in
    --worker) worker=1; shift ;;
    -w) want_wid=${2:-}; [ -n "$want_wid" ] || { echo "lvi-search: -w needs auto|WID" >&2; exit 2; }; shift 2 ;;
    -i) icase=1; shift ;;
    -b) back=1; shift ;;
    --) pat=${2:-}; break ;;          # end of flags: what follows is the pattern
    *)  pat=$1; break ;;
  esac
done
target=${want_wid:-${LVI_WID:-auto}}
wflag=; [ -n "$want_wid" ] && wflag="-w $want_wid"
# One flag, three spellings: the prompt character, the seed, and the step.
dir=/; seed=--at-cursor;      step=next
[ -n "$back" ] && { dir='?'; seed=--at-cursor-back; step=prev; }

# Prompt in the foreground (where `:!` handed us the tty). Skip when a pattern
# was supplied (e.g. `*` passes $LVI_CWORD) or when we are already the worker.
if [ -z "$worker" ] && [ -z "$pat" ]; then
  printf '%s' "$dir" >&2                          # prompt with the key you pressed
  IFS= read -r pat || exit 0
  [ -n "$pat" ] || exit 0
fi

# Detach the buffer-reading half; return at once so lvi's loop resumes and can
# service the worker's socket traffic.
if [ -z "$worker" ]; then
  ( "$0" --worker $wflag ${icase:+-i} ${back:+-b} -- "$pat" >"${LVI_SEARCH_DEBUG:-/dev/null}" 2>&1 & )
  exit 0
fi

# --- worker ------------------------------------------------------------------
# The buffer's filename (entries are file:line:text so cross-file tools share
# the format). `path` is empty for a pathless buffer -- unsaved, stdin, scratch
# -- so those entries carry no file and lvi-list jumps stay put. Safe because
# lvi-search only ever matches THIS buffer, so a match never needs a
# cross-file :e in the first place.
file=${LVI_FILE:-$("$LVI" -w "$target" -- path)}

# Resolve case policy: an explicit -i wins, else LVI_SEARCH_CASE decides (smart
# looks for an uppercase letter in the pattern, so a locale-aware [[:upper:]]).
iflag=
if [ -n "$icase" ]; then
  iflag=-i
else
  case "${LVI_SEARCH_CASE:-sensitive}" in
    ignore) iflag=-i ;;
    smart)  case "$pat" in *[[:upper:]]*) ;; *) iflag=-i ;; esac ;;
  esac
fi

# Validate the pattern BEFORE reading the buffer -- `PATTERN /dev/null` runs
# lvi-bre-locate's checks against no input at all -- so a typo costs nothing and
# is reported where there is still someone to tell.
lvi-bre-locate ${iflag:+-i} -- "$pat" /dev/null 2>/dev/null
case $? in
  2) "$LVI" -w "$target" --detach -- "hl search" "hl search-cur" "status search" \
                                     "msge bad pattern $dir$pat$dir"
     exit 0 ;;
esac

# The buffer goes to a file, not a variable: lvi-bre-locate reads it twice (the
# original lines and the marked stream) and so do we, for an entry's text. Beside
# the socket when we know where that is, since the file holds buffer content.
tdir=${LVI_SOCK%/*}; [ -n "$tdir" ] && [ -d "$tdir" ] || tdir=${TMPDIR:-/tmp}
buf=$(mktemp "$tdir/lvi-search.XXXXXX") || exit 1
hits=$(mktemp "$tdir/lvi-search.hits.XXXXXX") || exit 1
trap 'rm -f "$buf" "$hits"' EXIT HUP INT TERM
"$LVI" -w "$target" -- '%p' > "$buf"

# LINE<TAB>COL<TAB>LEN per occurrence, in vi's own BRE (see THE MATCHER).
lvi-bre-locate ${iflag:+-i} -- "$pat" "$buf" > "$hits" 2>/dev/null
locate=$?
if [ "$locate" = 0 ]; then
  # A zero-width match (`o*`, `^`) has a position and no extent, so it lands as a
  # bare `LINE.COL`; anything else carries its range.
  matches=$(LC_ALL=C awk -F'\t' -v f="$file" '
    NR == FNR { o[FNR] = $0; next }                  # the original lines
    $3 > 0 { printf "%s:%d.%d-%d: %s\n", f, $1, $2, $2 + $3 - 1, o[$1]; next }
            { printf "%s:%d.%d: %s\n",   f, $1, $2, o[$1] }' "$buf" "$hits")
else
  # Marker bytes in the pattern (4) or in the buffer (3): no extents are
  # trustworthy, so fall back to `grep -n` and the per-line entries this script
  # emitted before the marker pass existed.
  matches=$(grep -n $iflag -- "$pat" "$buf" | awk -v f="$file" '{print f":"$0}')
fi
if [ -z "$matches" ]; then
  # Clear the paint (both groups -- the current-entry mark would otherwise stay
  # on screen) and the stale counter; the notice itself is ephemeral, so :msge,
  # not a status segment. grep exit 2 is a bad BRE, not an empty result.
  # (A bad pattern never reaches here -- it is caught before the buffer is read.)
  notice="$dir$pat$dir no match"                   # echo the pattern as you typed it
  "$LVI" -w "$target" --detach -- "hl search" "hl search-cur" "status search" "msge $notice"
  exit 0
fi
# search owns its look so it shows without a theme (see CLAUDE.md). It re-sends
# this on every search, so an rc `hi search` gets overwritten -- restyle HERE
# (or in a wrapper), not in the rc.
# pri=10 lifts the mark above syntax highlighting (pri 0) so it shows through a
# styled first column (e.g. a Markdown `1.` ordered-list marker). `search-cur`
# sits one above that and adds bold: with every match lit, the one you are ON has
# to read differently from the rest, and bold says so without assuming a palette.
"$LVI" -w "$target" --detach -- "hi search reverse pri=10" "hi search-cur reverse bold pri=11"
# Seed from the cursor, then take one step off it -- that pair is the whole of
# "search starts where I am" (see WHERE A SEARCH STARTS). lvi-list owns the
# index; we name a direction and it does the arithmetic.
# --paint=extent: the match is the thing you are looking at, so light it rather
# than sign the line (see PAINT POLICY in contrib/lvi-list). Columns are bytes.
printf '%s\n' "$matches" \
  | lvi-list $wflag put search --focus --cols=byte --paint=extent "$seed"
lvi-list $wflag "$step"
