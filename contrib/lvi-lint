#!/bin/sh
# lvi-lint [-w auto|WID] [--focus] -- lint the LIVE buffer into an `lvi-list`.
#
# Run a linter over the current buffer (unsaved edits included), normalize its
# complaints to `file:line[:col]: text` entries, and hand them to `lvi-list put
# lint`. Stepping, painting, and the status counter all come from the shared
# list machinery. This is vim's makeprg/errorformat re-cut for "UNIX as IDE":
# no errorformat language, just a per-tool adapter that reshapes output in a few
# lines of awk.
#
# SYNOPSIS
#   lvi-lint                    lint the current buffer (run from a map or hook)
#   lvi-lint -w auto|WID        target a specific view instead of $LVI_WID
#   lvi-lint --focus            lint now and aim n/N at the results
#
# THE ADAPTER CONTRACT (the lvi-hl-<name> shape): an executable
# `lvi-lint-<name>` beside this script gets the buffer text on STDIN and the
# buffer's real filename as $1, and emits `FILE:LINE[:COL]: text` on stdout.
#   * FILE is $1 VERBATIM (not `-`, not a temp name), so entries match what
#     lvi calls the buffer and jump/paint work in place (the lvi-search trick).
#   * Severity folds into the text as an `E: `/`W: ` prefix. One list, so n
#     steps every finding -- but the prefix is also what picks the MARGIN GLYPH
#     (`E` vs `W`, groups LintError/LintWarn) when the lint list paints into a
#     gutter column, resolved to the most severe per line. See MARGIN GLYPHS
#     below. A backend that emits neither letter just gets no marks.
#   * COL, if the tool reports one, is passed through as the tool spells it.
#     Tools disagree about what a column counts -- bytes, characters, or display
#     cells with tabs expanded (what the GNU Coding Standards prescribe and gcc
#     emits). They agree on ASCII without tabs, so a mismatch shows up only as a
#     cursor landing near a complaint rather than on it, on a tab-indented or
#     multibyte line. lvi-list is told once, per list, and lvi converts: set
#     $LVI_LINT_COLS to `char` or `display` for a backend that needs it (default
#     `byte`). The shipped adapters declare nothing, so they get `byte`; if a
#     linter you use lands one column off on a tab-indented line, this is why.
# Feeding the buffer on stdin -- via the tool's --stdin-filename flag -- is what
# makes this live-buffer: no temp file, while the real path still anchors
# filetype detection and config resolution (ruff finds your pyproject.toml). A
# tool with no stdin mode can lint the disk file instead; its adapter header
# must then say "reflects your last :w" (the lvi-gitchanges caveat).
#
# Backend: $LVI_LINT_BACKEND if set, else picked from the file extension (table
# below). Ships ruff (python), shellcheck (sh), deno (js/ts), jq (json),
# xmlstarlet (xml/svg), tidy (html); eslint, luacheck, or `gcc -fsyntax-only`
# are a few more adapter lines when you want them.
#
# Bindings (rc):
#     on write lvi-lint                    " lint on every save
#     " on change lvi-lint                 " ...or as you type (it reads the live buffer)
#     map \e :bg lvi-lint --focus<CR>      " lint now and aim n/N at the results
#     map ]e :bg lvi-list next lint<CR>    " or step it with pinned keys
#     map [e :bg lvi-list prev lint<CR>
#     hi lint bg=52 pri=10                 " un-themed = invisible, so theme it
#     hi lint-cur bg=124 pri=11
# The status counter doubles as the pass/fail glance: `lint [0/17]` means
# findings, `lint [0/0]` after a run means clean. A failure never fakes that
# clean; how it surfaces depends on how you invoked it. Run BY HAND, every
# failure lands as a status-line error (:msge). Under a HOOK ($LVI_EVENT set),
# which re-fires on every settle of every buffer, a buffer that was never
# lintable (no file name, no backend for its extension) is skipped in silence,
# and configured-but-broken (linter not installed, no adapter, over the size
# cap) posts a `lint [...]` status segment instead -- idempotent across
# re-fires, replaced by the next successful run's counter.
#
# It self-backgrounds a --worker like lvi-highlight: reading the buffer needs
# lvi's event loop. Under `on write`/:bg the loop is live and the detach is
# harmless; under a `:silent !` binding it is what prevents the deadlock.
#
# Config: LVI (client, default `lvi`), LVI_LINT_BACKEND (adapter name),
# LVI_LINT_COLS (byte|char|display -- what the backend's columns count),
# LVI_LINT_MAXBYTES (skip buffers larger than this, default 262144),
# LVI_LINT_DEBUG (file to capture worker stderr). Needs lvi-list on PATH.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac
LVI=${LVI:-lvi}
MAXBYTES=${LVI_LINT_MAXBYTES:-262144}
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# Errors also go to the target's status line: the worker's stderr is discarded
# under every documented binding, so without :msge a failure looks like [0/0].
die() {
  echo "lvi-lint: $*" >&2
  [ -n "${target:-}" ] && "$LVI" -w "$target" --detach -- "msge lvi-lint: $*" 2>/dev/null
  exit 1
}

# The two hook voices (see the header). skip: unconfigured -- silent under a
# hook, die by hand. fail: configured but broken -- a `lint` status segment
# under a hook (the same segment the counter uses, so the next successful put
# clears it; re-posting the same text every settle repaints nothing), die by
# hand. $LVI_EVENT is the split: lvi sets it in hook children only.
skip() {
  [ -n "${LVI_EVENT:-}" ] && exit 0
  die "$*"
}
fail() {
  [ -z "${LVI_EVENT:-}" ] && die "$*"
  echo "lvi-lint: $*" >&2
  [ -n "${target:-}" ] && "$LVI" -w "$target" --detach -- "status lint [lvi-lint: $*]" 2>/dev/null
  exit 1
}

worker= want_wid= focus=
while [ $# -gt 0 ]; do
  case $1 in
    --worker) worker=1; shift ;;
    -w)       want_wid=${2:-}; [ -n "$want_wid" ] || die "-w needs auto|WID"; shift 2 ;;
    --focus)  focus=1; shift ;;
    *)        die "unknown argument '$1' (usage: lvi-lint [-w auto|WID] [--focus])" ;;
  esac
done
target=${want_wid:-${LVI_WID:-auto}}
wflag=; [ -n "$want_wid" ] && wflag="-w $want_wid"

# Detach the buffer-reading half; return at once so lvi's loop resumes and can
# service the worker's socket traffic.
if [ -z "$worker" ]; then
  ( "$0" --worker $wflag ${focus:+--focus} >"${LVI_LINT_DEBUG:-/dev/null}" 2>&1 & )
  exit 0
fi

# --- worker --------------------------------------------------------------------
# Cheap checks first, buffer read last: under `on change` this worker re-runs on
# every settle, and for a buffer that can't be linted at all (no name, no
# backend, no adapter) pulling the whole text over the socket each time is pure
# churn -- every round-trip is an event the editor repaints after.
# Cheapest of all, and first: what this backend's columns count. Checked HERE
# rather than left to lvi-list, which would `die` to a stderr nobody sees --
# under `:bg` it is discarded and under `:silent !` it is painted over, so a typo
# would just stop the list updating with no sign why. fail() puts it in the
# status segment, where there is someone to read it.
case "${LVI_LINT_COLS:-byte}" in
  byte|char|display) ;;
  *) fail "LVI_LINT_COLS='$LVI_LINT_COLS' (byte|char|display)" ;;
esac

fname=$("$LVI" -w "$target" -- path) || die "cannot read view $target"
[ -n "$fname" ] || skip "current buffer has no file (backends key off the name)"

backend=$LVI_LINT_BACKEND
if [ -z "$backend" ]; then
  case "$fname" in
    *.py)        backend=ruff ;;
    *.sh|*.bash) backend=shellcheck ;;
    *.js|*.jsx|*.ts|*.tsx|*.mjs|*.mts) backend=deno ;;
    *.json|*.jsonl) backend=jq ;;
    *.xml|*.svg|*.xsd|*.xsl|*.xslt|*.rng) backend=xmlstarlet ;;
    *.html|*.htm|*.xhtml) backend=tidy ;;
    *) skip "no backend for '$fname' (set LVI_LINT_BACKEND, or extend the table)" ;;
  esac
fi
adapter="$DIR/lvi-lint-$backend"
[ -x "$adapter" ] || fail "no adapter for backend '$backend'"

text=$("$LVI" -w "$target" -- '%p') || die "cannot read view $target"
nbytes=$(printf '%s' "$text" | wc -c)
if [ "$nbytes" -gt "$MAXBYTES" ]; then
  fail "${nbytes}B over cap ${MAXBYTES}B (raise LVI_LINT_MAXBYTES)"
fi

# Adapter normalizes; put paints, counts, and (with --focus) aims n/N.
# --at-cursor: an `on write` refresh mid-walk keeps your place instead of
# resetting the step index. An adapter with nothing to say yields an empty
# list -- the clean [0/0]. Captured first, so an adapter that FAILS (its
# missing-linter guard) is an error, not an ingest of empty input.
entries=$(printf '%s\n' "$text" | "$adapter" "$fname") ||
  fail "backend '$backend' failed (is the linter installed?)"
cols=${LVI_LINT_COLS:+--cols=$LVI_LINT_COLS}
if [ -n "$entries" ]; then
  printf '%s\n' "$entries" | lvi-list $wflag put lint --at-cursor ${focus:+--focus} $cols
else
  : | lvi-list $wflag put lint --at-cursor ${focus:+--focus} $cols
fi

# MARGIN GLYPHS. One mark per LINE, so severity has to be resolved here: a line
# with both an error and a warning is one cell, and only this script knows that E
# outranks W. The list keeps both findings either way -- n steps both and shows
# both messages; the mark is a per-line summary. lvi-list stores what it is given
# and never learns what E means, which is what keeps a vocabulary out of it (git
# hunks want +/-/~, and no table in lvi-list could hold both).
#
# Severity is the message's `E: `/`W: ` prefix, per THE ADAPTER CONTRACT above.
# Its field index depends on whether the adapter reported a column, the same fork
# lvi-list's own parser makes. A backend that emits neither letter simply yields
# no marks, and the list falls back to the single glyph its paint policy names.
printf '%s\n' "$entries" | awk -F: '
  /^[^ \t]/ && $2 ~ /^[0-9]/ {
    ln = $2; sub(/[.].*/, "", ln)                  # GNU also spells it line.col
    sev = ($3 ~ /^[0-9]+$/) ? $4 : $3              # the col-bearing form shifts it
    gsub(/^[ \t]+|[ \t]+$/, "", sev)
    rank = (sev == "E") ? 2 : (sev == "W") ? 1 : 0
    if (rank == 0) next                            # a letter we do not know: no mark
    key = $1 ":" ln
    if (!(key in best) || rank > best[key]) best[key] = rank
  }
  END {
    for (k in best) {
      g = (best[k] == 2) ? "E" : "W"
      grp = (best[k] == 2) ? "LintError" : "LintWarn"
      printf "%s\t%s\t%s\n", k, g, grp
    }
  }
' | lvi-list $wflag marks lint
