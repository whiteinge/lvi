#!/bin/sh
# lvi-yankring [-w auto|WID] push | get | cycle prev|next | pick | list | clear
#
# A yank/delete history you cycle through at paste time, like vim's YankRing or
# yanky.nvim. lvi grows no ring; this script owns it over the socket and a few
# files, reusing three pieces lvi already has: a register backend for capture, a
# read-backed register for the entry to paste, and one map that undoes a paste
# and re-puts the next entry.
#
# THE MODEL. Backing the unnamed register's `write` (`register " write
# lvi-yankring push`) fires `push` on EVERY yank and delete, so it captures them
# all with no key remapping. You paste normally with `p`/`P` (the newest entry,
# straight from the unnamed register). A cycle key then walks that paste back
# through older entries: it steps our cursor and sends `u"~p` -- undo the paste,
# put the now-current entry -- so each press swaps in the next entry down. A
# picker (`pick`) jumps to any entry directly.
#
#   push          stdin -> a new ring entry (register `write` backend). Dedups a
#                 consecutive repeat; resets the cycle cursor to the newest.
#   get           the current cursor entry -> stdout (register `read` backend).
#   cycle prev    step older / newer, then send `u"~p` (put over the socket).
#   cycle next    Press RIGHT AFTER a paste -- the `u` assumes the last change
#                 was that paste (the paste-then-cycle contract, as in YankRing).
#   pick          $LVI_PICKER over the ring (newest first, first line shown, each
#                 prefixed with its index and the wid that yanked it); paste the
#                 choice at the cursor (no undo -- a fresh paste, not a cycle).
#   list          the ring as `index<TAB>wid<TAB>first-line`, newest first (debug).
#   clear         forget the ring -- SHARED, so for every view (below).
#
# ONE RING, SHARED BY EVERY VIEW of this uid. That is the only topology: a yank
# in any pane is available in every other, which is most of what a ring is for
# once you run more than one lvi. Inside a single pane you lose nothing you had,
# since the named registers a-z already hold anything you meant to keep. It is
# session-scoped, NOT a persistent store: it sits in lvi's per-uid runtime dir
# beside the sockets, so $XDG_RUNTIME_DIR clears it at logout and deleted buffer
# text never accumulates on disk across reboots.
#
# STORAGE is one file per entry (raw bytes, newlines and all), named by a
# monotonic counter (`.seq`), higher = newer -- so ordering is arithmetic (no
# `ls`/`sort`) and `push`, which runs SYNCHRONOUSLY on the yank keystroke like a
# clipboard copy, is a few syscalls.
#   <rundir>/yankring/<n>        entry n (raw text)                   SHARED
#   <rundir>/yankring/.wid.<n>   the wid that yanked entry n          SHARED
#   <rundir>/yankring/.seq       last counter (newest = .seq)         SHARED
#   <rundir>/<wid>.yankring-cur  that view's cycle cursor (0 = newest)  PER VIEW
# The CURSOR is per view on purpose. The cycle contract is "undo MY last paste,
# put the next entry down", so it is view-local UI state, not ring data: share it
# and every pane's push (which resets the cursor) would yank the others out of
# their cycle mid-press. It lives in lvi's `<wid>.*` sidecar namespace, so
# list_sockets() reaps it when the view dies -- no stale cursors to sweep. The
# ring directory is not in that namespace (it is shared, and outlives any one
# view), and discovery ignores it because `yankring` is not a numeric wid.
#
# SLOT ALLOCATION is a `ln` compare-and-swap, not read-seq-then-write: with one
# global ring every pane contends for the counter, so a dropped entry would be
# routine rather than theoretical. See `push` for the loop.
#
# ENTRIES CARRY THEIR ORIGIN wid (`.wid.<n>`, shown by `pick` and `list`). Only a
# display today. It is here so that if the shared ring ever gets noisy enough
# that stepping it with cycle annoys, `cycle` can skip other views' entries while
# `pick` keeps showing everything -- without a migration.
#
# SPAWN DISCIPLINE. `push`/`get` are register backends, run inline (yank/put are
# synchronous) with $LVI_* exported, so they only touch files -- no socket call
# to deadlock. `cycle` is bound with `:bg` (detached, no alt-screen flash): it
# writes the cursor file, THEN sends `u"~p` with --detach, so the write
# happens-before the put and `get` reads the stepped cursor. `pick` needs the
# picker's tty (`:silent !`), so its socket put is --detach too, landing when
# lvi resumes.
#
# FIDELITY. The `write` backend gets only text, not the linewise flag, so `get`
# reads back like the clipboard: text with a trailing newline pastes linewise,
# without one charwise. A linewise yank round-trips; a charwise multi-line yank
# comes back linewise. Same tradeoff `"+` makes.
#
# Config: LVI (client, default `lvi`), LVI_PICKER (fzf/fzy/sk, default fzf; may carry flags),
# LVI_YANKRING_MAX (entries kept, default 50), LVI_YANKRING_REG (the read-backed
# register the maps put from, default `~` -- a name you will not yank into),
# LVI_YANKRING_DIR (relocate the shared store; for tests, not a workflow knob --
# the ring is global by design, so there is no per-view scope to opt back into).
# See lvirc.sample.vim for the register lines and key maps.

# -h/--help: print this script's header comment (its full reference), then exit.
case ${1:-} in -h|--help) exec awk 'NR==1&&/^#!/{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0" ;; esac

LVI=${LVI:-lvi}
PICKER=${LVI_PICKER:-fzf}
MAX=${LVI_YANKRING_MAX:-50}
REG=${LVI_YANKRING_REG:-'~'}

die()   { echo "lvi-yankring: $*" >&2; exit 1; }
usage() { echo "usage: lvi-yankring [-w auto|WID] push|get|cycle prev|next|pick|list|clear" >&2; exit 2; }

# ---- resolve this view + the one shared ring --------------------------------
want_wid=
[ "${1:-}" = "-w" ] && { want_wid=${2:-}; shift 2; }
sub=${1:-}; [ -n "$sub" ] || usage; shift

# We need a REAL wid, never the literal `auto`: it names this view's cursor file
# and tags the entries this view pushes. $LVI_WID covers every in-editor path
# (both register backends and all three maps) with no subprocess at all -- push
# runs synchronously on the yank keystroke, so the common path stays syscalls.
wid=${want_wid:-${LVI_WID:-auto}}
if [ "$wid" = auto ]; then
  n=$("$LVI" -l | grep -c .)
  [ "$n" = 1 ] || die "-w auto needs exactly one running view ($n found)"
  wid=$("$LVI" -l | cut -f1)
elif [ -n "$want_wid" ]; then                   # named by hand: fail loudly on a dead view
  "$LVI" -l | cut -f1 | grep -qxF "$wid" || die "no running view '$wid'"
fi

# ONE ring per uid, so all we need is the DIRECTORY the sockets live in -- never
# this view's own socket, which is what the per-view ring used to cost us (a
# three-branch lookup). $LVI_SOCK when lvi spawned us; otherwise any live view's
# socket names the same directory.
RUNDIR=${LVI_SOCK%/*}
if [ -z "$LVI_SOCK" ] || [ ! -d "$RUNDIR" ]; then
  s=$("$LVI" -l | sed -n 1p | cut -f2); RUNDIR=${s%/*}
fi
{ [ -n "$RUNDIR" ] && [ -d "$RUNDIR" ]; } || die "cannot find lvi's runtime dir"
dir=${LVI_YANKRING_DIR:-$RUNDIR/yankring}
cur=$RUNDIR/$wid.yankring-cur   # per view, and in lvi's `<wid>.*` sidecar namespace
                                # so list_sockets() reaps it when this view dies

send()   { "$LVI" -w "$wid" --detach -- "$@"; }                  # fire-and-forget (see header)
getseq() { s=$(cat "$dir/.seq" 2>/dev/null); case $s in ''|*[!0-9]*) echo 0;; *) echo "$s";; esac; }
getcur() { c=$(cat "$cur" 2>/dev/null); case $c in ''|*[!0-9]*) echo 0;; *) echo "$c";; esac; }
setcur() { printf '%s\n' "$1" > "$cur"; }
widof()  { cat "$dir/.wid.$1" 2>/dev/null || echo '?'; }         # who yanked entry n
count()  { s=$(getseq); [ "$s" -gt "$MAX" ] && echo "$MAX" || echo "$s"; }  # entries kept = min(seq, MAX)

case "$sub" in
  push)
    # Synchronous on the yank keystroke -- keep it to files. New text becomes the
    # newest entry (counter+1); a consecutive duplicate is dropped so holding a
    # paste-and-yank rhythm doesn't flood the ring. Either way the cursor resets
    # to the newest, so the next cycle starts one below what `p` just pasted.
    mkdir -p "$dir" 2>/dev/null || exit 0
    tmp=$(mktemp "$dir/.push.XXXXXX") || exit 0            # dot-prefixed: not an entry file
    trap 'rm -f "$tmp"' EXIT INT TERM
    cat > "$tmp"
    [ -s "$tmp" ] || { setcur 0; exit 0; }                # empty (e.g. a no-op delete): nothing to keep
    seq=$(getseq)
    if [ "$seq" -gt 0 ] && cmp -s "$tmp" "$dir/$seq"; then setcur 0; exit 0; fi  # dedup vs newest
    # Claim the slot with `ln`, which is atomic and FAILS if the name exists. One
    # shared ring means every pane's yanks contend for the counter, so the old
    # read-seq-then-mv would silently drop an entry whenever two landed together.
    # Counter values are monotonic and never reused, so a collision means only
    # that a concurrent push took that slot: step past it and retry. Bounded, so
    # a failure that ISN'T contention (a full disk) drops the yank, never spins.
    n=$((seq + 1)); tries=0
    until ln "$tmp" "$dir/$n" 2>/dev/null; do
      n=$((n + 1)); tries=$((tries + 1))
      [ "$tries" -gt 100 ] && exit 0
    done
    printf '%s\n' "$wid" > "$dir/.wid.$n"                  # tag it with the view that yanked it
    # .seq is max-wins: a concurrent push holding a LOWER slot must not walk the
    # counter back. Worst case it lags one entry until the next push.
    s=$(getseq); [ "$n" -gt "$s" ] && printf '%s\n' "$n" > "$dir/.seq"
    rm -f "$dir/$((n - MAX))" "$dir/.wid.$((n - MAX))"     # drop the one that fell past the cap
    setcur 0 ;;

  get)
    seq=$(getseq); [ "$seq" -gt 0 ] || exit 0
    total=$(count); c=$(getcur)
    [ "$c" -lt 0 ] && c=0; [ "$c" -ge "$total" ] && c=$((total - 1))
    n=$((seq - c))
    [ -f "$dir/$n" ] && cat "$dir/$n" ;;                  # missing (hand-deleted) -> empty -> put no-op

  cycle)
    total=$(count); [ "$total" -gt 0 ] || exit 0
    seq=$(getseq); was=$(getcur); c=$was
    case "${1:-}" in
      prev) c=$((c + 1)) ;;                               # older
      next) c=$((c - 1)) ;;                               # newer
      *)    die "cycle needs prev|next" ;;
    esac
    [ "$c" -lt 0 ] && c=0; [ "$c" -ge "$total" ] && c=$((total - 1))
    [ "$c" -eq "$was" ] && exit 0                         # at the ring's edge: re-putting the same entry would only grow the undo log
    setcur "$c"
    # Undo the paste, put the stepped entry; `fire` so change-hook consumers
    # (live highlighting) see the re-put text -- socket edits don't arm them.
    send "normal u\"${REG}p" fire ;;

  pick)
    total=$(count); [ "$total" -gt 0 ] || die "yankring empty"
    seq=$(getseq)
    # A self-contained "N: text" line: the index shows (a position readout) and
    # is parsed back off the front, so this works on any $LVI_PICKER -- no
    # fzf-only --with-nth/--delimiter, which fzy (a plain line filter) rejects.
    sel=$(i=0; while [ "$i" -lt "$total" ]; do
            e=$((seq - i))
            printf '%d: [%s] %s\n' "$i" "$(widof "$e")" "$(head -n1 "$dir/$e" 2>/dev/null)"
            i=$((i + 1))
          done | $PICKER) || exit 0
    i=${sel%%:*}
    case "$i" in ''|*[!0-9]*) exit 0 ;; esac
    setcur "$i"
    send "normal \"${REG}p" fire ;;                       # fresh paste of the chosen entry (no undo); fire: see cycle

  list)
    total=$(count); seq=$(getseq); i=0
    while [ "$i" -lt "$total" ]; do
      e=$((seq - i))
      printf '%d\t%s\t%s\n' "$i" "$(widof "$e")" "$(head -n1 "$dir/$e" 2>/dev/null)"
      i=$((i + 1))
    done ;;

  clear) rm -rf "$dir" ;;                                  # the ring is shared: clears it for EVERY view

  *) usage ;;
esac
